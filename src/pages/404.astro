---
import SnakeCRT from "../components/SnakeCRT.astro";

const siteUrl = "https://nicotomasin.com.ar";
const title = "404 | Página no encontrada";
const description = "404 - Página no encontrada. Jugá una partida de Snake estilo CRT.";
const image = "/og.png";
const ogImageUrl = `${siteUrl}${image}`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nico Tomasin" />
    <meta name="robots" content="noindex, nofollow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Nico Tomasin" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet" />
  </head>
  <body class="crt">
    <div class="bg-pattern"></div>
    <div class="crt-screen">
      <SnakeCRT mode="404" />
    </div>

    <!-- CRT Effects Layer -->
    <div class="crt-scanlines"></div>
    <div class="crt-vignette"></div>
    <div class="crt-flicker"></div>
    <div class="crt-rgb"></div>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #004643;
    --color-text: #abd1c6;
    --font-mono: "Share Tech Mono", monospace;
    --border-color: #abd1c6;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
    height: 100%;
    width: 100%;
  }

  /* === CRT MONITOR EFFECT === */

  /* Base CRT styling */
  .crt {
    overflow-x: hidden;
  }

  /* Background Pattern - diagonal lines */
  .bg-pattern {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background-image: repeating-linear-gradient(
      45deg,
      var(--color-text),
      var(--color-text) 1px,
      transparent 1px,
      transparent 20px
    );
    opacity: 0.05;
    pointer-events: none;
  }

  /* Screen container with subtle curvature effect */
  .crt-screen {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Subtle barrel distortion simulation */
    transform: perspective(1000px) rotateX(0.5deg);
    transform-origin: center center;
    animation: crt-turn-on 1s ease-out;
  }

  /* Scanlines effect - líneas horizontales clásicas CRT */
  .crt-scanlines {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1000;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 2px,
      rgba(0, 0, 0, 0.4) 2px,
      rgba(0, 0, 0, 0.4) 4px
    );
  }

  /* Vignette effect - darker corners like real CRT */
  .crt-vignette {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1001;
    background: radial-gradient(
      ellipse at center,
      transparent 0%,
      transparent 50%,
      rgba(0, 0, 0, 0.2) 80%,
      rgba(0, 0, 0, 0.5) 100%
    );
  }

  /* Subtle screen flicker */
  .crt-flicker {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1002;
    background: rgba(18, 16, 16, 0);
    animation: crt-flicker 0.1s infinite;
  }

  @keyframes crt-flicker {
    0% {
      opacity: 0.02;
    }
    50% {
      opacity: 0.04;
    }
    100% {
      opacity: 0.02;
    }
  }

  /* RGB pixel separation / chromatic aberration */
  .crt-rgb {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 999;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 0, 0, 0.02) 0px,
      rgba(0, 255, 0, 0.02) 1px,
      rgba(0, 0, 255, 0.02) 2px,
      transparent 3px,
      transparent 6px
    );
  }

  /* Phosphor glow effect on text */
  .crt ::selection {
    background: var(--color-text);
    color: var(--color-bg);
    text-shadow: none;
  }

  /* Occasional horizontal sync glitch line */
  .crt::after {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: rgba(171, 209, 198, 0.1);
    pointer-events: none;
    z-index: 1003;
    animation: crt-line 6s linear infinite;
    opacity: 0;
  }

  @keyframes crt-line {
    0% {
      top: -5px;
      opacity: 0;
    }
    5% {
      opacity: 0.5;
    }
    95% {
      opacity: 0.5;
    }
    100% {
      top: 100vh;
      opacity: 0;
    }
  }

  /* Turn on animation */
  @keyframes crt-turn-on {
    0% {
      transform: scaleY(0.01) scaleX(0.5);
      filter: brightness(30);
    }
    10% {
      transform: scaleY(0.01) scaleX(0.5);
      filter: brightness(30);
    }
    30% {
      transform: scaleY(1) scaleX(1);
      filter: brightness(1.5);
    }
    100% {
      transform: scaleY(1) scaleX(1);
      filter: brightness(1);
    }
  }

  /* Reduce motion for accessibility */
  @media (prefers-reduced-motion: reduce) {
    .crt-flicker,
    .crt::after {
      animation: none;
    }
    .crt-screen {
      animation: none;
    }
    .crt-scanlines {
      opacity: 0.2;
    }
  }
</style>
