---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import SearchBar from '../../components/blog/SearchBar.astro';
import Footer from '../../components/Footer.astro';
import ShaderBackground from '../../components/ShaderBackground.astro';
import { getCollection } from 'astro:content';
import { calculateReadingTime } from '../../lib/reading-time';
import { blogSchema } from '../../lib/schema';
import { getPostCover } from '../../lib/post-cover';

const blogEntries = await getCollection('blog', ({ data }) => !data.draft);

const allPosts = blogEntries
  .map((entry) => ({
    slug: entry.id,
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.date,
    category: entry.data.category,
    readingTime: calculateReadingTime(entry.body || ''),
    cover: getPostCover({ slug: entry.id, body: entry.body, tags: entry.data.tags, category: entry.data.category }),
  }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

const [featuredPost, ...restPosts] = allPosts;
const jsonLd = blogSchema(allPosts);

const searchIndexData = allPosts.map((post) => ({
  slug: post.slug,
  title: post.title,
  description: post.description,
  category: post.category,
  date: post.date.toLocaleDateString('es-AR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }),
  tags: blogEntries.find((e) => e.id === post.slug)?.data.tags ?? [],
}));
---

<Layout
  title="Blog de Nico Tomasin | Build in public"
  description="Cómo armé cada proyecto por dentro: bots en Rust, hardware con ESP32, productos web e IA local. Decisiones, arquitectura y aprendizajes."
  image="/og/blog.png"
  imageAlt="Blog de Nico Tomasin: lo que construyo, por dentro"
  jsonLd={jsonLd}
>
  <main class="blog-page">
    <header class="blog-header">
      <div class="blog-header-bg" aria-hidden="true">
        <ShaderBackground id="blog-shader-canvas" intensity={0.55} />
      </div>
      <div class="blog-header-overlay"></div>
      <div class="container blog-header-inner">
        <span class="section-label">Blog · Build in public</span>
        <h1 class="blog-title">Lo que construyo, <em>por dentro</em></h1>
        <p class="blog-description">
          Cómo armé cada proyecto: decisiones, arquitectura, errores y lo que aprendí.
          Bots, hardware, productos propios y herramientas del trabajo.
        </p>
        <p class="blog-stats">
          <span><strong>{allPosts.length}</strong> posts</span>
          <a href="/blog/rss.xml">RSS</a>
        </p>
      </div>
    </header>

    <section class="blog-content">
      <div class="container">
        <SearchBar />

        {featuredPost && (
          <div class="posts-featured">
            <PostCard {...featuredPost} featured />
          </div>
        )}

        <div class="posts-grid">
          {restPosts.map((post) => (
            <PostCard {...post} />
          ))}
        </div>

        <div class="no-posts" style="display: none;">
          <p>No se encontraron resultados.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />

</Layout>

<script define:vars={{ searchIndexData }}>
  if (typeof window !== 'undefined') {
    window.__BLOG_SEARCH_INDEX__ = searchIndexData;
  }
</script>

<style>
  .blog-page {
    padding-top: var(--nav-height);
    min-height: 100vh;
  }

  .blog-header {
    position: relative;
    padding: clamp(4rem, 10vw, 7rem) 0 clamp(3rem, 6vw, 4.5rem);
    overflow: hidden;
    background: #000;
  }

  .blog-header-bg {
    position: absolute;
    inset: 0;
    opacity: 0.85;
  }

  .blog-header-inner {
    position: relative;
    z-index: 2;
  }

  .blog-stats {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .blog-stats strong {
    color: var(--color-accent);
    font-weight: 400;
  }

  .blog-stats a {
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
  }

  .posts-featured {
    margin-bottom: 1.5rem;
  }

  .blog-header-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      linear-gradient(90deg, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.35) 55%, transparent 100%),
      linear-gradient(180deg, transparent 50%, var(--color-bg) 100%);
    z-index: 1;
  }

  .section-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .blog-title {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 1.6rem + 5vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin-bottom: 1.5rem;
    max-width: 13ch;
    color: var(--color-text);
  }

  .blog-title em {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-accent);
  }

  .blog-description {
    font-size: var(--step-1);
    color: var(--color-text-secondary);
    max-width: 52ch;
    line-height: 1.55;
  }

  .blog-content {
    padding: 3rem 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }

    .blog-header {
      padding: 4rem 0 3rem;
    }

    .blog-content {
      padding: 2rem 0;
    }
  }

  .no-posts {
    text-align: center;
    padding: 4rem 0;
    color: var(--color-text-secondary);
  }

  .no-posts p {
    font-size: 1.1rem;
  }
</style>
