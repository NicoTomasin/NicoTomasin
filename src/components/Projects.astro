---
import portfolioData from '../data/portfolio.json';

const { projects } = portfolioData;
const publicProjects = projects.filter(p => p.link !== '#');
const privateProjects = projects.filter(p => p.link === '#');
const initialPrivateShow = 6;
---

<section id="proyectos" class="section projects">
  <div class="container">
    <header class="section-header">
      <p class="section-label" data-reveal>Proyectos</p>
      <h2 class="section-title" data-split>Cosas que he construido</h2>
    </header>
  </div>

  <!-- Public Projects - horizontal scroll en desktop -->
  <div class="public-pin" data-hscroll>
    <div class="public-track" data-hscroll-track>
      {publicProjects.map((project, i) => (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class="public-card"
          data-cursor="Visitar"
          data-card
        >
          <span class="public-card-index" data-card-parallax>{String(i + 1).padStart(2, '0')}</span>
          <div class="public-card-glow" data-card-parallax></div>
          <div class="public-card-body">
            <div class="public-card-top">
              <span class="public-card-count">{String(i + 1).padStart(2, '0')} / {String(publicProjects.length).padStart(2, '0')}</span>
              <svg class="external-arrow" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
            </div>
            <div class="public-card-bottom">
              <h3 class="public-card-title">{project.title}</h3>
              <p class="public-card-desc">{project.description}</p>
              <div class="public-card-tech">
                {project.tech.split(', ').map((tech) => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
    <div class="hscroll-progress" aria-hidden="true"><span data-hscroll-progress></span></div>
  </div>

  <div class="container">
    <!-- Private Projects Section -->
    <div class="private-section">
      <div class="private-header">
        <h3 class="private-title" data-split>Proyectos privados</h3>
        <span class="private-count" data-reveal>
          <svg class="lock" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path class="lock-shackle" d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          {String(privateProjects.length).padStart(2, '0')} proyectos sin código público
        </span>
        <span class="private-line" data-private-line></span>
      </div>

      <div class="private-grid" id="privateGrid">
        {privateProjects.map((project, index) => (
          <div class="private-card" data-index={index} data-private-card>
            <span class="private-spot" aria-hidden="true"></span>
            <div class="private-card-inner">
              <div class="private-card-header">
                <span class="private-card-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="private-badge">
                  <svg class="lock" xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path class="lock-shackle" d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  Privado
                </span>
              </div>
              <h4 class="private-card-title">{project.title}</h4>
              <p class="private-card-desc">{project.description}</p>
              <div class="private-card-tech">
                {project.tech.split(', ').slice(0, 3).map((tech) => (
                  <span class="tech-chip-small" data-chip>{tech}</span>
                ))}
                {project.tech.split(', ').length > 3 && (
                  <span class="tech-chip-more" data-chip>+{project.tech.split(', ').length - 3}</span>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <button class="expand-btn" id="expandBtn">
        <span class="expand-text">Ver más proyectos</span>
        <svg class="expand-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .projects {
    background: linear-gradient(180deg, 
      #000000 0%, 
      #000000 25%,
      #080810 45%,
      #0e0e16 65%,
      var(--color-surface) 100%
    );
    padding-top: 4rem;
  }

  /* ===== PUBLIC PROJECTS (horizontal) ===== */
  .public-pin {
    position: relative;
    margin-bottom: 5rem;
  }

  .public-track {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0 1.5rem;
  }

  .public-card {
    position: relative;
    display: flex;
    min-height: 420px;
    border-radius: 24px;
    overflow: hidden;
    text-decoration: none;
    background: linear-gradient(160deg, #13131c 0%, #0b0b11 100%);
    border: 1px solid var(--color-border);
    isolation: isolate;
    transition: border-color 0.4s ease;
  }

  .public-card:hover {
    border-color: rgba(0, 255, 136, 0.5);
    color: inherit;
  }

  .public-card-index {
    font-family: var(--font-display);
    position: absolute;
    right: -0.05em;
    bottom: -0.2em;
    font-size: clamp(10rem, 28vw, 26rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
    color: rgba(255, 255, 255, 0.035);
    z-index: -1;
    pointer-events: none;
    transition: color 0.4s ease;
  }

  .public-card:hover .public-card-index {
    color: rgba(0, 255, 136, 0.1);
  }

  .public-card-glow {
    position: absolute;
    width: 70%;
    aspect-ratio: 1;
    left: -20%;
    top: -35%;
    background: radial-gradient(circle, rgba(0, 255, 136, 0.18) 0%, transparent 65%);
    z-index: -1;
    pointer-events: none;
    opacity: 0.6;
    transition: opacity 0.4s ease;
  }

  .public-card:hover .public-card-glow {
    opacity: 1;
  }

  .public-card-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    padding: clamp(1.5rem, 3vw, 3rem);
    gap: 2rem;
  }

  .public-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .public-card-count {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: var(--color-text-secondary);
  }

  .external-arrow {
    color: var(--color-accent);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .public-card:hover .external-arrow {
    transform: translate(6px, -6px) scale(1.15);
  }

  .public-card-bottom {
    max-width: 560px;
  }

  .public-card-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0 0 1rem 0;
    color: var(--color-text);
  }

  .public-card-desc {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }

  .public-card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    background: rgba(0, 255, 136, 0.08);
    padding: 0.35rem 0.8rem;
    border-radius: 100px;
    border: 1px solid rgba(0, 255, 136, 0.2);
  }

  .hscroll-progress {
    display: none;
  }

  @media (min-width: 1024px) {
    .public-pin {
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
    }

    .public-track {
      flex-direction: row;
      width: max-content;
      gap: 2rem;
      padding: 0 max(1.5rem, calc((100vw - var(--max-width)) / 2 + 1.5rem));
      will-change: transform;
    }

    .public-card {
      width: min(68vw, 920px);
      height: min(68vh, 620px);
      min-height: 0;
      flex-shrink: 0;
    }

    .hscroll-progress {
      display: block;
      width: min(var(--max-width), calc(100vw - 3rem));
      margin: 2.5rem auto 0;
      height: 2px;
      background: var(--color-border);
      border-radius: 2px;
      overflow: hidden;
    }

    .hscroll-progress span {
      display: block;
      height: 100%;
      background: var(--color-accent);
      transform-origin: left;
      transform: scaleX(0);
    }
  }

  /* ===== PRIVATE SECTION ===== */
  .private-section {
    position: relative;
  }

  .private-header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .private-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
  }

  .private-count {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .private-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-border) 40%);
    transform-origin: left;
  }

  .lock-shackle {
    transform-box: fill-box;
    transform-origin: 100% 100%;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .private-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    perspective: 1200px;
  }

  @media (min-width: 640px) {
    .private-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .private-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .private-card {
    --mx: 50%;
    --my: 50%;
    position: relative;
    display: flex;
    border-radius: 16px;
    padding: 1px;
    background: var(--color-border);
    overflow: hidden;
    isolation: isolate;
    will-change: transform;
  }

  /* Borde que se ilumina siguiendo al mouse */
  .private-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(260px circle at var(--mx) var(--my), rgba(0, 255, 136, 0.75), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 0;
  }

  .private-card-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 1.4rem;
    border-radius: 15px;
    background: #101017;
  }

  /* Spotlight interior */
  .private-spot {
    position: absolute;
    inset: 1px;
    border-radius: 15px;
    background: radial-gradient(320px circle at var(--mx) var(--my), rgba(0, 255, 136, 0.09), transparent 65%);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 2;
    pointer-events: none;
  }

  .private-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .private-card-index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    transition: color 0.3s ease;
  }

  .private-card-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 0.5rem 0;
    color: var(--color-text);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .private-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.25rem 0.55rem;
    border-radius: 100px;
    border: 1px solid var(--color-border);
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .private-card-desc {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0 0 1.25rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .private-card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }

  .tech-chip-small {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.25rem 0.6rem;
    border-radius: 100px;
    transition: color 0.3s ease, background-color 0.3s ease;
  }

  .tech-chip-more {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-accent);
    padding: 0.25rem 0.5rem;
  }

  /* Hovers solo con mouse (evita estados "pegados" en touch) */
  @media (hover: hover) {
    .private-card:hover::before,
    .private-card:hover .private-spot {
      opacity: 1;
    }

    .private-card:hover .private-card-index,
    .private-card:hover .private-badge {
      color: var(--color-accent);
    }

    .private-card:hover .private-badge {
      border-color: rgba(0, 255, 136, 0.35);
    }

    .private-card:hover .private-card-title {
      transform: translateX(6px);
    }

    .private-card:hover .tech-chip-small {
      color: var(--color-accent);
      background: rgba(0, 255, 136, 0.08);
    }

    /* El candado se "abre" */
    .private-card:hover .lock-shackle,
    .private-count:hover .lock-shackle {
      transform: translateY(-18%) rotate(-18deg);
    }
  }

  /* ===== EXPAND BUTTON (Mobile) ===== */
  .expand-btn {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.5rem auto 0;
    padding: 0.6rem 1.25rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .expand-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .expand-icon {
    transition: transform 0.3s ease;
  }

  .expand-btn.expanded .expand-icon {
    transform: rotate(180deg);
  }

  @media (max-width: 639px) {
    .expand-btn {
      display: flex;
    }

    .private-card {
      display: none;
    }

    .private-card[data-index="0"],
    .private-card[data-index="1"],
    .private-card[data-index="2"],
    .private-card[data-index="3"],
    .private-card[data-index="4"],
    .private-card[data-index="5"] {
      display: flex;
    }

    .private-grid.expanded .private-card {
      display: flex !important;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('privateGrid');
    const btn = document.getElementById('expandBtn');
    const text = btn?.querySelector('.expand-text');

    if (btn && grid) {
      btn.addEventListener('click', () => {
        const isExpanded = grid.classList.toggle('expanded');
        btn.classList.toggle('expanded', isExpanded);
        if (text) {
          text.textContent = isExpanded ? 'Ver menos' : 'Ver más proyectos';
        }
      });
    }
  });
</script>
