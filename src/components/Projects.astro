---
import portfolioData from '../data/portfolio.json';
import { getBuilds } from '../lib/builds';
import { type Lang, l, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const featured = (await getBuilds())
  .filter((build) => build.featured && build.href)
  .map((build) => ({
    ...build,
    cursor: build.external ? t('featured.visit') : t('featured.read'),
    category: l(portfolioData.categories[build.category as keyof typeof portfolioData.categories], lang),
  }));
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="proyectos" class="section projects">
  <div class="container">
    <header class="section-header">
      <p class="section-label" data-reveal>{t('featured.label')}</p>
      <h2 class="section-title" data-split>{t('featured.title')}</h2>
    </header>
  </div>

  <div class="public-pin" data-hscroll>
    <div class="public-track" data-hscroll-track>
      {featured.map((project, i) => (
        <a
          href={project.href}
          target={project.external ? '_blank' : undefined}
          rel={project.external ? 'noopener noreferrer' : undefined}
          class="public-card"
          data-cursor={project.cursor}
          data-card
        >
          <span class="public-card-index" data-card-parallax aria-hidden="true">{pad(i + 1)}</span>
          <div class="public-card-glow" data-card-parallax aria-hidden="true"></div>
          <div class="public-card-body">
            <div class="public-card-top">
              <span class="public-card-count">{pad(i + 1)} / {pad(featured.length)} · {project.category} · {project.year}</span>
              <svg class="external-arrow" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {project.external ? (<><path d="M7 17 17 7"/><path d="M7 7h10v10"/></>) : (<><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></>)}
              </svg>
            </div>
            <div class="public-card-bottom">
              <h3 class="public-card-title">{project.title}</h3>
              <p class="public-card-desc">{l(project.description, lang)}</p>
              <div class="public-card-tech">
                {project.tech.map((tech) => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
    <div class="hscroll-progress" aria-hidden="true"><span data-hscroll-progress></span></div>
  </div>
</section>

<style>
  .projects {
    background: linear-gradient(180deg, var(--color-bg) 0%, #0e0e16 60%, var(--color-surface) 100%);
  }

  /* ===== PUBLIC PROJECTS (horizontal) ===== */
  .public-pin {
    position: relative;
  }

  .public-track {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0 1.5rem;
  }

  .public-card {
    position: relative;
    display: flex;
    min-height: clamp(360px, 70svh, 460px);
    border-radius: 24px;
    overflow: hidden;
    text-decoration: none;
    background: linear-gradient(160deg, #13131c 0%, #0b0b11 100%);
    border: 1px solid var(--color-border);
    isolation: isolate;
    transition: border-color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .public-card:hover {
      border-color: var(--accent-line);
      color: inherit;
    }

    .public-card:hover .public-card-index {
      color: rgba(0, 255, 136, 0.1);
    }

    .public-card:hover .public-card-glow {
      opacity: 1;
    }

    .public-card:hover .external-arrow {
      transform: translate(4px, -4px);
    }
  }

  .public-card-index {
    font-family: var(--font-display);
    position: absolute;
    right: -0.05em;
    bottom: -0.2em;
    font-size: clamp(10rem, 28vw, 26rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
    color: rgba(255, 255, 255, 0.035);
    z-index: -1;
    pointer-events: none;
    transition: color 0.4s ease;
  }


  .public-card-glow {
    position: absolute;
    width: 70%;
    aspect-ratio: 1;
    left: -20%;
    top: -35%;
    background: radial-gradient(circle, rgba(0, 255, 136, 0.18) 0%, transparent 65%);
    z-index: -1;
    pointer-events: none;
    opacity: 0.6;
    transition: opacity 0.4s ease;
  }


  .public-card-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    padding: clamp(1.5rem, 3vw, 3rem);
    gap: 2rem;
  }

  .public-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .public-card-count {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: var(--color-text-secondary);
  }

  .external-arrow {
    color: var(--color-accent);
    transition: transform var(--dur-ui) var(--ease-out);
  }


  .public-card-bottom {
    max-width: 560px;
  }

  .public-card-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0 0 1rem 0;
    color: var(--color-text);
  }

  .public-card-desc {
    max-width: 52ch;
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }

  .public-card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    background: rgba(0, 255, 136, 0.08);
    padding: 0.35rem 0.8rem;
    border-radius: 100px;
    border: 1px solid rgba(0, 255, 136, 0.2);
  }

  .hscroll-progress {
    display: none;
  }

  @media (min-width: 1024px) {
    :global(.has-motion) .public-pin {
      height: 100vh;
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
    }

    :global(.has-motion) .public-track {
      flex-direction: row;
      width: max-content;
      gap: 2rem;
      padding: 0 max(1.5rem, calc((100vw - var(--max-width)) / 2 + 1.5rem));
      will-change: transform;
    }

    :global(.has-motion) .public-card {
      width: min(68vw, 920px);
      height: min(68vh, 620px);
      min-height: 0;
      flex-shrink: 0;
    }

    :global(.has-motion) .hscroll-progress {
      display: block;
      width: min(var(--max-width), calc(100vw - 3rem));
      margin: 2.5rem auto 0;
      height: 2px;
      background: var(--color-border);
      border-radius: 2px;
      overflow: hidden;
    }

    .hscroll-progress span {
      display: block;
      height: 100%;
      background: var(--color-accent);
      transform-origin: left;
      transform: scaleX(0);
    }
  }
  /* Sin motion (reduced motion / sin JS): grilla en vez de scroll horizontal pineado */
  @media (min-width: 1024px) {
    :global(html:not(.has-motion)) .public-track {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      max-width: var(--max-width);
      margin: 0 auto;
    }
  }


</style>
