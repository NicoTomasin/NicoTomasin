---
import portfolioData from '../data/portfolio.json';

const { projects } = portfolioData;
const publicProjects = projects.filter(p => p.link !== '#');
const privateProjects = projects.filter(p => p.link === '#');
const initialPrivateShow = 6;
---

<section id="proyectos" class="section projects">
  <div class="container">
    <header class="section-header">
      <p class="section-label" data-reveal>Proyectos</p>
      <h2 class="section-title" data-split>Cosas que he construido</h2>
    </header>
  </div>

  <!-- Public Projects - horizontal scroll en desktop -->
  <div class="public-pin" data-hscroll>
    <div class="public-track" data-hscroll-track>
      {publicProjects.map((project, i) => (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class="public-card"
          data-cursor="Visitar"
          data-card
        >
          <span class="public-card-index" data-card-parallax>{String(i + 1).padStart(2, '0')}</span>
          <div class="public-card-glow" data-card-parallax></div>
          <div class="public-card-body">
            <div class="public-card-top">
              <span class="public-card-count">{String(i + 1).padStart(2, '0')} / {String(publicProjects.length).padStart(2, '0')}</span>
              <svg class="external-arrow" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
            </div>
            <div class="public-card-bottom">
              <h3 class="public-card-title">{project.title}</h3>
              <p class="public-card-desc">{project.description}</p>
              <div class="public-card-tech">
                {project.tech.split(', ').map((tech) => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
    <div class="hscroll-progress" aria-hidden="true"><span data-hscroll-progress></span></div>
  </div>

  <div class="container">
    <!-- Private Projects Section -->
    <div class="private-section">
      <h3 class="private-title" data-reveal>
        <span class="private-title-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </span>
        Proyectos privados
      </h3>

      <div class="private-grid" id="privateGrid">
        {privateProjects.map((project, index) => (
          <div class="private-card" data-index={index} data-batch>
            <div class="private-card-header">
              <h4 class="private-card-title">{project.title}</h4>
              <span class="private-badge">Privado</span>
            </div>
            <p class="private-card-desc">{project.description}</p>
            <div class="private-card-tech">
              {project.tech.split(', ').slice(0, 3).map((tech) => (
                <span class="tech-chip-small">{tech}</span>
              ))}
              {project.tech.split(', ').length > 3 && (
                <span class="tech-chip-more">+{project.tech.split(', ').length - 3}</span>
              )}
            </div>
          </div>
        ))}
      </div>

      <button class="expand-btn" id="expandBtn">
        <span class="expand-text">Ver más proyectos</span>
        <svg class="expand-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .projects {
    background: linear-gradient(180deg, 
      #000000 0%, 
      #000000 25%,
      #080810 45%,
      #0e0e16 65%,
      var(--color-surface) 100%
    );
    padding-top: 4rem;
  }

  /* ===== PUBLIC PROJECTS (horizontal) ===== */
  .public-pin {
    position: relative;
    margin-bottom: 5rem;
  }

  .public-track {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 0 1.5rem;
  }

  .public-card {
    position: relative;
    display: flex;
    min-height: 420px;
    border-radius: 24px;
    overflow: hidden;
    text-decoration: none;
    background: linear-gradient(160deg, #13131c 0%, #0b0b11 100%);
    border: 1px solid var(--color-border);
    isolation: isolate;
    transition: border-color 0.4s ease;
  }

  .public-card:hover {
    border-color: rgba(0, 255, 136, 0.5);
    color: inherit;
  }

  .public-card-index {
    position: absolute;
    right: -0.05em;
    bottom: -0.2em;
    font-size: clamp(10rem, 28vw, 26rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.08);
    z-index: -1;
    pointer-events: none;
    transition: -webkit-text-stroke-color 0.4s ease;
  }

  .public-card:hover .public-card-index {
    -webkit-text-stroke-color: rgba(0, 255, 136, 0.35);
  }

  .public-card-glow {
    position: absolute;
    width: 70%;
    aspect-ratio: 1;
    left: -20%;
    top: -35%;
    background: radial-gradient(circle, rgba(0, 255, 136, 0.18) 0%, transparent 65%);
    z-index: -1;
    pointer-events: none;
    opacity: 0.6;
    transition: opacity 0.4s ease;
  }

  .public-card:hover .public-card-glow {
    opacity: 1;
  }

  .public-card-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    padding: clamp(1.5rem, 3vw, 3rem);
    gap: 2rem;
  }

  .public-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .public-card-count {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    color: var(--color-text-secondary);
  }

  .external-arrow {
    color: var(--color-accent);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .public-card:hover .external-arrow {
    transform: translate(6px, -6px) scale(1.15);
  }

  .public-card-bottom {
    max-width: 560px;
  }

  .public-card-title {
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 0 0 1rem 0;
    color: var(--color-text);
  }

  .public-card-desc {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }

  .public-card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    background: rgba(0, 255, 136, 0.08);
    padding: 0.35rem 0.8rem;
    border-radius: 100px;
    border: 1px solid rgba(0, 255, 136, 0.2);
  }

  .hscroll-progress {
    display: none;
  }

  @media (min-width: 1024px) {
    .public-pin {
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
    }

    .public-track {
      flex-direction: row;
      width: max-content;
      gap: 2rem;
      padding: 0 max(1.5rem, calc((100vw - var(--max-width)) / 2 + 1.5rem));
      will-change: transform;
    }

    .public-card {
      width: min(68vw, 920px);
      height: min(68vh, 620px);
      min-height: 0;
      flex-shrink: 0;
    }

    .hscroll-progress {
      display: block;
      width: min(var(--max-width), calc(100vw - 3rem));
      margin: 2.5rem auto 0;
      height: 2px;
      background: var(--color-border);
      border-radius: 2px;
      overflow: hidden;
    }

    .hscroll-progress span {
      display: block;
      height: 100%;
      background: var(--color-accent);
      transform-origin: left;
      transform: scaleX(0);
    }
  }

  /* ===== PRIVATE SECTION ===== */
  .private-section {
    position: relative;
  }

  .private-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin: 0 0 1.5rem 0;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .private-title-icon {
    display: flex;
    align-items: center;
    opacity: 0.6;
  }

  .private-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .private-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .private-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .private-card {
    display: flex;
    flex-direction: column;
    background: rgba(18, 18, 26, 0.5);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.25rem;
    transition: all 0.2s ease;
  }

  .private-card:hover {
    border-color: rgba(255, 255, 255, 0.1);
    background: rgba(18, 18, 26, 0.8);
  }

  .private-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .private-card-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-text);
  }

  .private-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .private-card-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0 0 0.75rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .private-card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }

  .tech-chip-small {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .tech-chip-more {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-accent);
    padding: 0.2rem 0.5rem;
  }

  /* ===== EXPAND BUTTON (Mobile) ===== */
  .expand-btn {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.5rem auto 0;
    padding: 0.6rem 1.25rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .expand-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .expand-icon {
    transition: transform 0.3s ease;
  }

  .expand-btn.expanded .expand-icon {
    transform: rotate(180deg);
  }

  @media (max-width: 639px) {
    .expand-btn {
      display: flex;
    }

    .private-card {
      display: none;
    }

    .private-card[data-index="0"],
    .private-card[data-index="1"],
    .private-card[data-index="2"],
    .private-card[data-index="3"],
    .private-card[data-index="4"],
    .private-card[data-index="5"] {
      display: flex;
    }

    .private-grid.expanded .private-card {
      display: flex !important;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('privateGrid');
    const btn = document.getElementById('expandBtn');
    const text = btn?.querySelector('.expand-text');

    if (btn && grid) {
      btn.addEventListener('click', () => {
        const isExpanded = grid.classList.toggle('expanded');
        btn.classList.toggle('expanded', isExpanded);
        if (text) {
          text.textContent = isExpanded ? 'Ver menos' : 'Ver más proyectos';
        }
      });
    }
  });
</script>
