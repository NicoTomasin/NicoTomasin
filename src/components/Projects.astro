---
import portfolioData from '../data/portfolio.json';

const { projects } = portfolioData;
const publicProjects = projects.filter(p => p.link !== '#');
const privateProjects = projects.filter(p => p.link === '#');
const initialPrivateShow = 6;
---

<section id="proyectos" class="section projects">
  <div class="container">
    <header class="section-header">
      <p class="section-label">Proyectos</p>
      <h2 class="section-title">Cosas que he construido</h2>
    </header>

    <!-- Public Projects - Large Cards -->
    <div class="public-grid">
      {publicProjects.map((project) => (
        <a 
          href={project.link} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="public-card"
        >
          <div class="public-card-header">
            <div class="public-card-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            </div>
            <svg class="external-arrow" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
          </div>
          <h3 class="public-card-title">{project.title}</h3>
          <p class="public-card-desc">{project.description}</p>
          <div class="public-card-tech">
            {project.tech.split(', ').map((tech) => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
        </a>
      ))}
    </div>

    <!-- Private Projects Section -->
    <div class="private-section">
      <h3 class="private-title">
        <span class="private-title-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </span>
        Proyectos privados
      </h3>

      <div class="private-grid" id="privateGrid">
        {privateProjects.map((project, index) => (
          <div class="private-card" data-index={index}>
            <div class="private-card-header">
              <h4 class="private-card-title">{project.title}</h4>
              <span class="private-badge">Privado</span>
            </div>
            <p class="private-card-desc">{project.description}</p>
            <div class="private-card-tech">
              {project.tech.split(', ').slice(0, 3).map((tech) => (
                <span class="tech-chip-small">{tech}</span>
              ))}
              {project.tech.split(', ').length > 3 && (
                <span class="tech-chip-more">+{project.tech.split(', ').length - 3}</span>
              )}
            </div>
          </div>
        ))}
      </div>

      <button class="expand-btn" id="expandBtn">
        <span class="expand-text">Ver más proyectos</span>
        <svg class="expand-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .projects {
    background: linear-gradient(180deg, 
      #000000 0%, 
      #000000 25%,
      #080810 45%,
      #0e0e16 65%,
      var(--color-surface) 100%
    );
    padding-top: 4rem;
  }

  /* ===== PUBLIC PROJECTS (Large Cards) ===== */
  .public-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .public-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  .public-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 2rem;
    text-decoration: none;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .public-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .public-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(0, 255, 136, 0.15);
  }

  .public-card:hover::before {
    transform: scaleX(1);
  }

  .public-card:hover .external-arrow {
    opacity: 1;
    transform: translate(4px, -4px);
  }

  .public-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .public-card-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 255, 136, 0.1);
    border-radius: 12px;
    color: var(--color-accent);
  }

  .external-arrow {
    opacity: 0;
    color: var(--color-accent);
    transition: all 0.3s ease;
  }

  .public-card-title {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 0 0 0.75rem 0;
    color: var(--color-text);
  }

  .public-card-desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0 0 1.5rem 0;
    flex: 1;
  }

  .public-card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    background: rgba(0, 255, 136, 0.1);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    border: 1px solid rgba(0, 255, 136, 0.2);
  }

  /* ===== PRIVATE SECTION ===== */
  .private-section {
    position: relative;
  }

  .private-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin: 0 0 1.5rem 0;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .private-title-icon {
    display: flex;
    align-items: center;
    opacity: 0.6;
  }

  .private-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .private-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .private-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .private-card {
    display: flex;
    flex-direction: column;
    background: rgba(18, 18, 26, 0.5);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1.25rem;
    transition: all 0.2s ease;
  }

  .private-card:hover {
    border-color: rgba(255, 255, 255, 0.1);
    background: rgba(18, 18, 26, 0.8);
  }

  .private-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .private-card-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-text);
  }

  .private-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    flex-shrink: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .private-card-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0 0 0.75rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .private-card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }

  .tech-chip-small {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .tech-chip-more {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-accent);
    padding: 0.2rem 0.5rem;
  }

  /* ===== EXPAND BUTTON (Mobile) ===== */
  .expand-btn {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.5rem auto 0;
    padding: 0.6rem 1.25rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .expand-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .expand-icon {
    transition: transform 0.3s ease;
  }

  .expand-btn.expanded .expand-icon {
    transform: rotate(180deg);
  }

  @media (max-width: 639px) {
    .expand-btn {
      display: flex;
    }

    .private-card[data-index]:not([data-index="0"]):not([data-index="1"]):not([data-index="2"]):not([data-index="3"]):not([data-index="4"]):not([data-index="5"]) {
      display: none;
    }

    .private-grid.expanded .private-card {
      display: flex;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('privateGrid');
    const btn = document.getElementById('expandBtn');
    const text = btn?.querySelector('.expand-text');

    if (btn && grid) {
      btn.addEventListener('click', () => {
        const isExpanded = grid.classList.toggle('expanded');
        btn.classList.toggle('expanded', isExpanded);
        if (text) {
          text.textContent = isExpanded ? 'Ver menos' : 'Ver más proyectos';
        }
      });
    }
  });
</script>
