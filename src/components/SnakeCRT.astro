---
const uid = `snake-${Math.random().toString(36).slice(2)}`;

interface Props {
  mode?: "default" | "404";
}

const { mode = "default" } = Astro.props;
---

<div class="snake" id={uid} data-snake-root>
  <canvas class="canvas" data-canvas tabindex="0" aria-label="Snake CRT canvas"></canvas>

  <div class="controls" aria-label="Controles táctiles">
    <button class="pad up" type="button" data-dir="up" aria-label="Arriba">↑</button>
    <button class="pad left" type="button" data-dir="left" aria-label="Izquierda">←</button>
    <button class="pad right" type="button" data-dir="right" aria-label="Derecha">→</button>
    <button class="pad down" type="button" data-dir="down" aria-label="Abajo">↓</button>
  </div>
</div>

<style>
  .snake {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .canvas {
    display: block;
    outline: none;
    max-width: 100vw;
    max-height: 100vh;
  }

  .controls {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: grid;
    grid-template-areas:
      ". up ."
      "left . right"
      ". down .";
    grid-template-columns: 52px 52px 52px;
    grid-template-rows: 52px 52px 52px;
    gap: 0.35rem;
    z-index: 10;
  }

  .pad {
    font-family: var(--font-mono);
    border: 1px solid var(--border-color);
    background: rgba(0, 0, 0, 0.35);
    color: inherit;
    cursor: pointer;
    display: grid;
    place-items: center;
    user-select: none;
    touch-action: manipulation;
    font-size: 1.25rem;
  }

  .pad:active {
    background-color: var(--color-text);
    color: var(--color-bg);
  }

  .pad.up {
    grid-area: up;
  }
  .pad.down {
    grid-area: down;
  }
  .pad.left {
    grid-area: left;
  }
  .pad.right {
    grid-area: right;
  }

  @media (min-width: 860px) {
    .controls {
      display: none;
    }
  }
</style>

<script define:vars={{ uid, mode }}>
  // Snake CRT (vanilla) — encapsulado por root id
  /** @type {HTMLElement | null} */
  const root = document.getElementById(uid);
  if (!root) throw new Error("SnakeCRT root not found");

  const canvas = root.querySelector("[data-canvas]");
  const padButtons = Array.from(root.querySelectorAll("[data-dir]"));

  if (!(canvas instanceof HTMLCanvasElement)) throw new Error("SnakeCRT canvas not found");

  const ctx = canvas.getContext("2d");
  if (!ctx) throw new Error("SnakeCRT could not get 2D context");

  const GRID = 24;
  const BASE_MS = 120;
  const MIN_MS = 60;

  const css = getComputedStyle(root);
  const COLOR_TEXT = (css.getPropertyValue("--color-text") || "#ABD1C6").trim();
  const COLOR_BG = (css.getPropertyValue("--color-bg") || "#004643").trim();

  /** @type {{x:number,y:number}[]} */
  let snake = [];
  /** @type {{x:number,y:number}} */
  let dir = { x: 1, y: 0 };
  /** @type {{x:number,y:number}} */
  let nextDir = { x: 1, y: 0 };
  /** @type {{x:number,y:number}} */
  let food = { x: 0, y: 0 };
  let score = 0;
  /** @type {"idle"|"running"|"gameover"} */
  let state = "idle";
  /** @type {ReturnType<typeof window.setInterval> | null} */
  let tickTimer = null;

  let canvasPx = 512;
  let cellPx = canvasPx / GRID;
  let dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));

  /**
   * @param {number} n
   * @param {number} a
   * @param {number} b
   */
  function clamp(n, a, b) {
    return Math.max(a, Math.min(b, n));
  }

  function updateScore() {}

  function resizeCanvas() {
    // Usar el menor entre ancho y alto del viewport para un cuadrado que quepa
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    canvasPx = Math.floor(Math.min(vw, vh) * 0.92);
    cellPx = canvasPx / GRID;
    dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));

    canvas.style.width = `${canvasPx}px`;
    canvas.style.height = `${canvasPx}px`;
    canvas.width = Math.floor(canvasPx * dpr);
    canvas.height = Math.floor(canvasPx * dpr);

    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(dpr, dpr);
    draw();
  }

  /**
   * @param {number} x
   * @param {number} y
   * @param {number} pad
   */
  function cellRect(x, y, pad) {
    const x0 = Math.round(x * cellPx + pad);
    const y0 = Math.round(y * cellPx + pad);
    const x1 = Math.round((x + 1) * cellPx - pad);
    const y1 = Math.round((y + 1) * cellPx - pad);
    return { x: x0, y: y0, w: Math.max(1, x1 - x0), h: Math.max(1, y1 - y0) };
  }

  /**
   * @param {string} text
   * @param {number} x
   * @param {number} y
   * @param {number} sizePx
   * @param {number} alpha
   * @param {"left"|"center"|"right"} align
   */
  function drawText(text, x, y, sizePx, alpha, align) {
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.fillStyle = COLOR_TEXT;
    ctx.shadowColor = COLOR_TEXT;
    ctx.shadowBlur = 10;
    ctx.font = `${sizePx}px "Share Tech Mono", monospace`;
    ctx.textAlign = align;
    ctx.textBaseline = "top";
    ctx.fillText(text, x, y);
    ctx.restore();
  }

  /**
   * @param {{x:number,y:number}} a
   * @param {{x:number,y:number}} b
   */
  function sameDir(a, b) {
    return a.x === b.x && a.y === b.y;
  }

  /**
   * @param {{x:number,y:number}} a
   * @param {{x:number,y:number}} b
   */
  function isReverse(a, b) {
    return a.x === -b.x && a.y === -b.y;
  }

  function randCell() {
    return Math.floor(Math.random() * GRID);
  }

  function placeFood() {
    // Evitar colocar comida sobre el snake
    let attempts = 0;
    while (attempts++ < 5000) {
      const candidate = { x: randCell(), y: randCell() };
      const hit = snake.some((s) => s.x === candidate.x && s.y === candidate.y);
      if (!hit) {
        food = candidate;
        return;
      }
    }
    // fallback (no debería pasar)
    food = { x: 0, y: 0 };
  }

  function reset() {
    const startX = Math.floor(GRID / 2) - 2;
    const startY = Math.floor(GRID / 2);
    snake = [
      { x: startX + 3, y: startY },
      { x: startX + 2, y: startY },
      { x: startX + 1, y: startY },
      { x: startX + 0, y: startY },
    ];
    dir = { x: 1, y: 0 };
    nextDir = { x: 1, y: 0 };
    score = 0;
    placeFood();
    draw();
  }

  /**
   * @param {"gameover"|"idle"} next
   */
  function stopGame(next) {
    state = next;
    if (tickTimer != null) {
      window.clearInterval(tickTimer);
      tickTimer = null;
    }
    draw();
  }

  function startGame() {
    reset();
    state = "running";
    canvas.focus();

    const tick = () => {
      step();
      draw();
    };

    if (tickTimer != null) window.clearInterval(tickTimer);
    tickTimer = window.setInterval(tick, BASE_MS);
  }

  function setTickSpeed() {
    if (tickTimer == null) return;
    const ms = Math.floor(clamp(BASE_MS - score * 2, MIN_MS, BASE_MS));
    window.clearInterval(tickTimer);
    tickTimer = window.setInterval(() => {
      step();
      draw();
    }, ms);
  }

  function step() {
    if (state !== "running") return;
    // Aplicar próxima dirección (si no es reversa)
    if (!sameDir(nextDir, dir) && !isReverse(nextDir, dir)) {
      dir = nextDir;
    }

    const head = snake[0];
    const next = { x: head.x + dir.x, y: head.y + dir.y };

    // Pared
    if (next.x < 0 || next.y < 0 || next.x >= GRID || next.y >= GRID) {
      stopGame("gameover");
      return;
    }

    // Self
    // Permitimos movernos al último segmento si en este tick no comemos (porque el tail se desplaza)
    const willEat = next.x === food.x && next.y === food.y;
    const bodyToCheck = willEat ? snake : snake.slice(0, -1);
    if (bodyToCheck.some((s) => s.x === next.x && s.y === next.y)) {
      stopGame("gameover");
      return;
    }

    snake.unshift(next);

    // Comer
    if (willEat) {
      score += 1;
      placeFood();
      setTickSpeed();
    } else {
      snake.pop();
    }
  }

  function draw() {
    const t = performance.now();
    // Fondo
    ctx.clearRect(0, 0, canvasPx, canvasPx);
    ctx.fillStyle = "rgba(0,0,0,0.35)";
    ctx.fillRect(0, 0, canvasPx, canvasPx);

    // Marco mínimo
    ctx.save();
    ctx.globalAlpha = 0.22;
    ctx.strokeStyle = COLOR_TEXT;
    ctx.lineWidth = 1;
    ctx.strokeRect(0.5, 0.5, canvasPx - 1, canvasPx - 1);
    ctx.restore();

    // Gradiente sutil tipo fósforo
    ctx.save();
    const bg = ctx.createLinearGradient(0, 0, 0, canvasPx);
    bg.addColorStop(0, "rgba(0,0,0,0.0)");
    bg.addColorStop(0.5, "rgba(0,0,0,0.18)");
    bg.addColorStop(1, "rgba(0,0,0,0.0)");
    ctx.globalAlpha = 0.55;
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, canvasPx, canvasPx);
    ctx.restore();

    // Grid muy sutil
    ctx.save();
    ctx.strokeStyle = COLOR_TEXT;
    ctx.globalAlpha = 0.08;
    ctx.lineWidth = 1;
    for (let i = 0; i <= GRID; i++) {
      const p = Math.round(i * cellPx) + 0.5;
      ctx.beginPath();
      ctx.moveTo(p, 0);
      ctx.lineTo(p, canvasPx);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(0, p);
      ctx.lineTo(canvasPx, p);
      ctx.stroke();
    }
    ctx.globalAlpha = 1;
    ctx.restore();

    // Línea de sincronía horizontal ocasional
    if (state === "running") {
      ctx.save();
      const y = (t / 12) % canvasPx;
      ctx.globalAlpha = 0.08;
      ctx.fillStyle = COLOR_TEXT;
      ctx.fillRect(0, y, canvasPx, 2);
      ctx.restore();
    }

    if (state !== "idle") {
      // Comida
      ctx.save();
      ctx.imageSmoothingEnabled = false;
      ctx.shadowColor = COLOR_TEXT;
      ctx.shadowBlur = 10;
      ctx.fillStyle = COLOR_TEXT;
      const fr = cellRect(food.x, food.y, Math.max(2, Math.round(cellPx * 0.18)));
      ctx.fillRect(fr.x, fr.y, fr.w, fr.h);
      ctx.restore();

      // Snake
      ctx.save();
      ctx.imageSmoothingEnabled = false;
      ctx.shadowColor = COLOR_TEXT;
      ctx.shadowBlur = 8;
      snake.forEach((s, idx) => {
        ctx.globalAlpha = idx === 0 ? 0.95 : 0.72;
        ctx.fillStyle = COLOR_TEXT;
        const r = cellRect(s.x, s.y, Math.max(1, Math.round(cellPx * 0.12)));
        ctx.fillRect(r.x, r.y, r.w, r.h);
      });
      ctx.globalAlpha = 1;
      ctx.restore();
    }

    // Vignette (muy leve) y noise
    ctx.save();
    const vig = ctx.createRadialGradient(canvasPx / 2, canvasPx / 2, canvasPx * 0.15, canvasPx / 2, canvasPx / 2, canvasPx * 0.7);
    vig.addColorStop(0, "rgba(0,0,0,0)");
    vig.addColorStop(1, "rgba(0,0,0,0.35)");
    ctx.fillStyle = vig;
    ctx.fillRect(0, 0, canvasPx, canvasPx);

    // Noise: puntos mínimos, barato
    ctx.globalAlpha = 0.06;
    ctx.fillStyle = COLOR_TEXT;
    const dots = 90;
    for (let i = 0; i < dots; i++) {
      const x = Math.floor(Math.random() * canvasPx);
      const y = Math.floor(Math.random() * canvasPx);
      ctx.fillRect(x, y, 1, 1);
    }
    ctx.restore();

    // UI dentro del canvas (idle / gameover / score)
    const pad = Math.max(12, Math.round(canvasPx * 0.04));
    const titleSize = clamp(Math.round(canvasPx * 0.055), 18, 34);
    const smallSize = clamp(Math.round(canvasPx * 0.032), 12, 18);

    if (state === "idle") {
      const title = mode === "404" ? "OH OH... NO SE ENCONTRÓ LA PÁGINA" : "SNAKE CRT";
      const line2 = mode === "404" ? "¿PERO QUERÉS JUGAR?" : "¿LISTO PARA JUGAR?";
      drawText(title, canvasPx / 2, pad, titleSize, 0.95, "center");
      drawText(line2, canvasPx / 2, pad + titleSize + 10, titleSize, 0.9, "center");
      drawText("CLICK / ENTER / ESPACIO PARA EMPEZAR", canvasPx / 2, canvasPx - pad - smallSize * 2 - 10, smallSize, 0.85, "center");
      drawText("FLECHAS/WASD · SWIPE · D-PAD", canvasPx / 2, canvasPx - pad - smallSize - 2, smallSize, 0.7, "center");
    } else {
      drawText(`SCORE: ${score}`, canvasPx - pad, pad, smallSize, 0.9, "right");
      if (state === "gameover") {
        const y = canvasPx / 2 - titleSize * 0.6;
        drawText("GAME OVER", canvasPx / 2, y, titleSize, 0.95, "center");
        drawText("CLICK / ENTER / ESPACIO PARA REINICIAR", canvasPx / 2, y + titleSize + 10, smallSize, 0.8, "center");
      }
    }
  }

  /**
   * @param {"up"|"down"|"left"|"right"} name
   */
  function setDirection(name) {
    if (state !== "running") return;
    switch (name) {
      case "up":
        nextDir = { x: 0, y: -1 };
        break;
      case "down":
        nextDir = { x: 0, y: 1 };
        break;
      case "left":
        nextDir = { x: -1, y: 0 };
        break;
      case "right":
        nextDir = { x: 1, y: 0 };
        break;
    }
  }

  // Controles teclado
  /** @param {KeyboardEvent} e */
  const onKeyDown = (e) => {
    const key = e.key.toLowerCase();

    // Atajos para arrancar
    if (state !== "running" && (key === "enter" || key === " ")) {
      e.preventDefault();
      startGame();
      return;
    }

    if (state !== "running") return;

    // Evitar scroll con flechas mientras se juega
    if (["arrowup", "arrowdown", "arrowleft", "arrowright"].includes(key)) {
      e.preventDefault();
    }

    if (key === "arrowup" || key === "w") setDirection("up");
    else if (key === "arrowdown" || key === "s") setDirection("down");
    else if (key === "arrowleft" || key === "a") setDirection("left");
    else if (key === "arrowright" || key === "d") setDirection("right");
  };
  window.addEventListener("keydown", onKeyDown, { passive: false });

  // Controles D-pad (touch/pointer)
  padButtons.forEach((btn) => {
    if (!(btn instanceof HTMLButtonElement)) return;
    const dirName = btn.dataset.dir;
    /** @param {PointerEvent} e */
    btn.addEventListener("pointerdown", (e) => {
      e.preventDefault();
      canvas.focus();
      if (state !== "running") {
        startGame();
        return;
      }
      if (dirName === "up" || dirName === "down" || dirName === "left" || dirName === "right") {
        setDirection(dirName);
      }
    });
  });

  // Swipe sobre canvas
  /** @type {{x:number,y:number,active:boolean}} */
  let swipe = { x: 0, y: 0, active: false };

  /** @param {PointerEvent} e */
  canvas.addEventListener("pointerdown", (e) => {
    if (state !== "running") {
      startGame();
      return;
    }
    swipe = { x: e.clientX, y: e.clientY, active: true };
  });
  /** @param {PointerEvent} e */
  canvas.addEventListener("pointerup", (e) => {
    if (!swipe.active) return;
    swipe.active = false;
    if (state !== "running") return;

    const dx = e.clientX - swipe.x;
    const dy = e.clientY - swipe.y;
    const ax = Math.abs(dx);
    const ay = Math.abs(dy);
    const TH = 18;
    if (ax < TH && ay < TH) return;

    if (ax > ay) setDirection(dx > 0 ? "right" : "left");
    else setDirection(dy > 0 ? "down" : "up");
  });

  // Init
  state = "idle";
  resizeCanvas();
  reset();

  const onResize = () => resizeCanvas();
  window.addEventListener("resize", onResize, { passive: true });
</script>
