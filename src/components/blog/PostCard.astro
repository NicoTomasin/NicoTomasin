---
import { formatReadingTime } from '../../lib/reading-time';
import type { PostCover as Cover } from '../../lib/post-cover';
import PostCover from './PostCover.astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  date: Date;
  category: string;
  readingTime: number;
  featured?: boolean;
  cover: Cover;
}

const { title, description, slug, date, category, readingTime, featured = false, cover } = Astro.props;

const formattedDate = date.toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<article class:list={['post-card', { 'is-featured': featured }]}>
  <a href={`/blog/${slug}`} class="post-link">
    <div class="post-image-wrapper">
      <div class="post-image"><PostCover cover={cover} eager={featured} /></div>
    </div>
    <div class="post-content">
      <div class="post-meta">
        <span class="post-category">{category}</span>
        <span class="post-separator" aria-hidden="true">·</span>
        <time datetime={date.toISOString()} class="post-date">{formattedDate}</time>
        <span class="post-separator" aria-hidden="true">·</span>
        <span class="post-reading-time">{formatReadingTime(readingTime)}</span>
      </div>
      <h2 class="post-title">{title}</h2>
      <p class="post-description">{description}</p>
      <span class="post-read-more" aria-hidden="true">Leer →</span>
    </div>
  </a>
</article>

<style>
  .post-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color var(--dur-ui) ease;
  }

  .post-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .post-link:active {
    transform: scale(0.99);
    transition: transform var(--dur-press) var(--ease-out);
  }

  .post-image-wrapper {
    position: relative;
    aspect-ratio: 40 / 21;
    overflow: hidden;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .post-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease-out);
  }

  .post-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .post-category {
    color: var(--color-accent);
  }

  .post-separator {
    opacity: 0.5;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin-bottom: 0.6rem;
    color: var(--color-text);
    text-wrap: balance;
    transition: color var(--dur-ui) ease;
  }

  .post-description {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-read-more {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    transition: transform var(--dur-ui) var(--ease-out);
  }

  /* Destacado: imagen y texto lado a lado en pantallas anchas */
  @media (min-width: 900px) {
    .is-featured .post-link {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
    }

    /* La OG tiene texto: se muestra entera, centrada sobre el fondo */
    .is-featured .post-image-wrapper {
      aspect-ratio: auto;
      min-height: 22rem;
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
    }

    .is-featured .post-content {
      justify-content: center;
      padding: 2.5rem;
    }

    .is-featured .post-title {
      font-size: clamp(1.8rem, 1rem + 1.8vw, 2.6rem);
      letter-spacing: -0.035em;
    }

    .is-featured .post-description {
      font-size: 1.05rem;
      -webkit-line-clamp: 4;
      line-clamp: 4;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .post-card:hover {
      border-color: var(--accent-line);
    }

    .post-card:hover .post-image {
      transform: scale(1.03);
    }

    .post-card:hover .post-title {
      color: var(--color-accent);
    }

    .post-card:hover .post-read-more {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card:hover .post-image {
      transform: none;
    }
  }
</style>
