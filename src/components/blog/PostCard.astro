---
import { formatReadingTime } from '../../lib/reading-time';

interface Props {
  title: string;
  description: string;
  slug: string;
  date: Date;
  category: string;
  readingTime: number;
}

const { title, description, slug, date, category, readingTime } = Astro.props;

const formattedDate = date.toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const ogImage = `/og/blog/${slug}.png`;
---

<article class="post-card">
  <a href={`/blog/${slug}`} class="post-link">
    <div class="post-image-wrapper">
      <img src={ogImage} alt={title} class="post-image" loading="lazy" />
      <div class="post-image-overlay"></div>
    </div>
    <div class="post-content">
      <div class="post-meta">
        <span class="post-category">{category}</span>
        <span class="post-separator">·</span>
        <time datetime={date.toISOString()} class="post-date">{formattedDate}</time>
        <span class="post-separator">·</span>
        <span class="post-reading-time">{formatReadingTime(readingTime)}</span>
      </div>
      <h2 class="post-title">{title}</h2>
      <p class="post-description">{description}</p>
      <span class="post-read-more">Leer más →</span>
    </div>
  </a>
</article>

<style>
  .post-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .post-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow: 0 8px 32px rgba(0, 255, 136, 0.1);
  }

  .post-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-image-wrapper {
    position: relative;
    aspect-ratio: 40 / 21;
    overflow: hidden;
  }

  .post-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .post-card:hover .post-image {
    transform: scale(1.05);
  }

  .post-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 15, 0.9) 0%, transparent 40%);
    pointer-events: none;
  }

  .post-content {
    padding: 1.5rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
  }

  .post-category {
    font-family: var(--font-mono);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .post-separator {
    color: var(--color-text-secondary);
    opacity: 0.5;
  }

  .post-date,
  .post-reading-time {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.5rem;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .post-card:hover .post-title {
    color: var(--color-accent);
  }

  .post-description {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-read-more {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 500;
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .post-card:hover .post-read-more {
    transform: translateX(4px);
  }
</style>
