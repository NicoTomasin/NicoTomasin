---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
  <slot />
</div>

<style is:global>
  .prose {
    color: var(--color-text);
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .prose :where(h2, h3, h4, h5, h6) {
    color: var(--color-text);
    margin-top: 2.5em;
    margin-bottom: 0.75em;
    line-height: 1.3;
  }

  .prose :where(h2) {
    font-size: 1.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .prose :where(h2)::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 1em;
    background: var(--color-accent);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .prose :where(h3) {
    font-size: 1.35rem;
    font-weight: 600;
  }

  .prose :where(h4) {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .prose :where(p) {
    margin-bottom: 1.25em;
  }

  .prose :where(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 0.2s ease;
  }

  .prose :where(a):hover {
    opacity: 0.8;
  }

  .prose :where(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .prose :where(img) {
    border-radius: 12px;
    margin: 2em auto;
    border: 1px solid var(--color-border);
    max-width: 100%;
    height: auto;
  }

  .prose :where(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1.25em;
    margin: 1.5em 0;
    font-style: italic;
    color: var(--color-text-secondary);
    background: var(--color-surface);
    padding: 1em 1.25em;
    border-radius: 0 8px 8px 0;
  }

  .prose :where(ul, ol) {
    margin: 1.25em 0;
    padding-left: 0;
  }

  .prose :where(ul) {
    list-style: none;
  }

  .prose :where(ul > li) {
    position: relative;
    padding-left: 1.5em;
    margin-bottom: 0.5em;
  }

  .prose :where(ul > li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
  }

  .prose :where(ol) {
    list-style: none;
    counter-reset: list-counter;
  }

  .prose :where(ol > li) {
    counter-increment: list-counter;
    position: relative;
    padding-left: 2em;
    margin-bottom: 0.5em;
  }

  .prose :where(ol > li)::before {
    content: counter(list-counter);
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.85em;
    font-weight: 600;
  }

  .prose :where(code):not(pre code) {
    background: var(--color-surface);
    color: var(--color-accent);
    padding: 0.2em 0.4em;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
    border: 1px solid var(--color-border);
  }

  .prose :where(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.25em;
    overflow-x: auto;
    margin: 1.5em 0;
    font-size: 0.9em;
    line-height: 1.6;
  }

  .prose :where(pre code) {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-text);
  }

  .prose :where(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2em 0;
    font-size: 0.95em;
  }

  .prose :where(thead) {
    background: var(--color-surface);
  }

  .prose :where(th) {
    text-align: left;
    padding: 0.75em 1em;
    font-weight: 600;
    border-bottom: 2px solid var(--color-border);
  }

  .prose :where(td) {
    padding: 0.75em 1em;
    border-bottom: 1px solid var(--color-border);
  }

  .prose :where(tr:last-child td) {
    border-bottom: none;
  }

  .prose :where(hr) {
    border: none;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent,
      var(--color-border),
      var(--color-accent),
      var(--color-border),
      transparent
    );
    margin: 3em 0;
  }

  .prose :where(br) {
    display: block;
    content: '';
    margin-top: 0.5em;
  }

  .prose .callout {
    padding: 1rem 1.25rem;
    border-radius: 8px;
    margin: 1.5em 0;
    border-left: 4px solid var(--color-accent);
  }

  .prose .callout-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .prose .callout-icon {
    font-size: 1.1rem;
  }

  .prose .callout-content {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .prose .callout-content :first-child {
    margin-top: 0;
  }

  .prose .callout-content :last-child {
    margin-bottom: 0;
  }

  .prose .callout-tip {
    background: rgba(99, 102, 241, 0.1);
    border-color: #6366f1;
  }

  .prose .callout-tip .callout-title {
    color: #818cf8;
  }

  .prose .callout-warning {
    background: rgba(245, 158, 11, 0.1);
    border-color: #f59e0b;
  }

  .prose .callout-warning .callout-title {
    color: #fbbf24;
  }

  .prose .callout-note {
    background: rgba(59, 130, 246, 0.1);
    border-color: #3b82f6;
  }

  .prose .callout-note .callout-title {
    color: #60a5fa;
  }

  .prose .callout-quote {
    background: rgba(139, 92, 246, 0.1);
    border-color: #8b5cf6;
  }

  .prose .callout-quote .callout-title {
    color: #a78bfa;
  }

  .prose .callout-info {
    background: rgba(14, 165, 233, 0.1);
    border-color: #0ea5e9;
  }

  .prose .callout-info .callout-title {
    color: #38bdf8;
  }

  .prose .callout-danger {
    background: rgba(239, 68, 68, 0.1);
    border-color: #ef4444;
  }

  .prose .callout-danger .callout-title {
    color: #f87171;
  }

  .prose .callout-success {
    background: rgba(34, 197, 94, 0.1);
    border-color: #22c55e;
  }

  .prose .callout-success .callout-title {
    color: #4ade80;
  }

  .prose .callout-failure {
    background: rgba(239, 68, 68, 0.1);
    border-color: #dc2626;
  }

  .prose .callout-failure .callout-title {
    color: #fca5a5;
  }

  .prose .callout-bug {
    background: rgba(168, 85, 247, 0.1);
    border-color: #a855f7;
  }

  .prose .callout-bug .callout-title {
    color: #c084fc;
  }

  .prose .callout-example {
    background: rgba(236, 72, 153, 0.1);
    border-color: #ec4899;
  }

  .prose .callout-example .callout-title {
    color: #f472b6;
  }

  .prose .callout-question {
    background: rgba(34, 211, 238, 0.1);
    border-color: #22d3ee;
  }

  .prose .callout-question .callout-title {
    color: #67e8f9;
  }

  .prose .mermaid-wrapper {
    margin: 2em 0;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow-x: auto;
  }

  .prose .mermaid-wrapper pre.mermaid {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    font-size: 0.95rem;
  }

  .prose .footnotes {
    margin-top: 3em;
    padding-top: 1.5em;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  .prose .footnotes-sep {
    display: none;
  }

  .prose .footnotes ol {
    list-style: decimal;
    padding-left: 1.5em;
  }

  .prose .footnotes ol > li {
    padding-left: 0.5em;
    margin-bottom: 0.5em;
  }

  .prose .footnotes ol > li::before {
    display: none;
  }

  .prose sup > a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .prose sup > a:hover {
    text-decoration: underline;
  }

  .prose .footnote-ref {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .prose .footnote-backref {
    font-family: var(--font-mono);
    font-size: 0.85em;
    margin-left: 0.25em;
  }

  .prose .code-block-with-title {
    margin: 1.5em 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .prose .code-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6em 1em;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--color-border);
  }

  .prose .code-block-title {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
  }

  .prose .code-block-lang {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    font-family: var(--font-mono);
    opacity: 0.7;
  }

  .prose .code-block-with-title pre {
    margin: 0;
    border: none;
    border-radius: 0;
    background: transparent;
  }

  .prose .code-block-with-title pre code {
    background: transparent;
    border: none;
    padding: 0;
  }

  .prose details {
    margin: 1.5em 0;
    padding: 1em 1.25em;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .prose details:hover {
    border-color: var(--color-accent);
  }

  .prose details[open] {
    border-color: var(--color-accent);
  }

  .prose summary {
    font-weight: 600;
    color: var(--color-text);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    outline: none;
  }

  .prose summary::-webkit-details-marker {
    display: none;
  }

  .prose summary::before {
    content: '▶';
    font-size: 0.7rem;
    color: var(--color-accent);
    transition: transform 0.2s ease;
  }

  .prose details[open] summary::before {
    transform: rotate(90deg);
  }

  .prose details :not(summary) {
    margin-top: 1em;
    padding-top: 1em;
    border-top: 1px solid var(--color-border);
  }

  .prose .twitter-tweet {
    margin: 1.5em auto !important;
  }
</style>
