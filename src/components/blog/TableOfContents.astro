---
interface Heading {
  slug: string;
  text: string;
  depth: number;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <nav class="toc" id="toc" aria-label="Tabla de contenidos">
    <button class="toc-toggle pressable" id="tocToggle" aria-expanded="false" aria-controls="tocContent">
      <span class="toc-icon" aria-hidden="true">≡</span>
      <span class="toc-label">Contenido</span>
      <span class="toc-count">{filteredHeadings.length} secciones</span>
      <svg class="toc-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>
    <div class="toc-content" id="tocContent">
      <span class="toc-title">En esta página</span>
      <ul class="toc-list">
        {filteredHeadings.map((heading) => (
          <li class={`toc-item toc-depth-${heading.depth}`}>
            <a href={`#${heading.slug}`} class="toc-link">
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<style>
  .toc {
    position: sticky;
    top: calc(var(--nav-height) + 2rem);
    max-height: calc(100vh - var(--nav-height) - 4rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .toc-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    width: 100%;
    justify-content: flex-start;
  }

  .toc-icon {
    color: var(--color-accent);
  }

  .toc-content {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1rem;
  }

  .toc-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
    display: block;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .toc-item {
    margin: 0;
  }

  .toc-depth-3 {
    padding-left: 1rem;
  }

  .toc-link {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    display: block;
    padding: 0.25rem 0;
    border-left: 2px solid transparent;
    padding-left: 0.5rem;
    margin-left: -0.5rem;
    transition: color var(--dur-ui) ease, border-color var(--dur-ui) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .toc-link:hover {
      color: var(--color-accent);
      border-left-color: var(--color-accent);
    }
  }

  .toc-link.active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
  }

  .toc-count {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .toc-chevron {
    color: var(--color-text-secondary);
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .toc-toggle[aria-expanded='true'] .toc-chevron {
    transform: rotate(180deg);
  }

  @media (max-width: 1200px) {
    .toc {
      position: static;
      max-height: none;
      overflow: visible;
      margin-bottom: 2rem;
    }

    .toc-toggle {
      display: flex;
      padding: 0.85rem 1rem;
    }

    .toc-content {
      display: none;
      margin-top: 0.5rem;
    }

    .toc-content.open {
      display: block;
    }

    .toc-link {
      padding-top: 0.45rem;
      padding-bottom: 0.45rem;
    }
  }
</style>

<script>
  const tocToggle = document.getElementById('tocToggle');
  const tocContent = document.getElementById('tocContent');

  tocToggle?.addEventListener('click', () => {
    const open = tocContent?.classList.toggle('open') ?? false;
    tocToggle.setAttribute('aria-expanded', String(open));
  });

  const tocLinks = document.querySelectorAll('.toc-link');
  const headings = document.querySelectorAll('h2[id], h3[id]');

  function updateActiveLink() {
    let currentId = '';

    headings.forEach((heading) => {
      const rect = heading.getBoundingClientRect();
      if (rect.top <= 150) {
        currentId = heading.getAttribute('id') || '';
      }
    });

    tocLinks.forEach((link) => {
      link.classList.remove('active');
      if (link.getAttribute('href') === `#${currentId}`) {
        link.classList.add('active');
      }
    });
  }

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateActiveLink();
        ticking = false;
      });
    },
    { passive: true }
  );
  updateActiveLink();

  tocLinks.forEach((link) => {
    link.addEventListener('click', () => {
      tocContent?.classList.remove('open');
      tocToggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
