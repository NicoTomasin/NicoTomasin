---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const messages = [
  '¡Seguí leyendo!',
  '¡Qué bueno este post!',
  '¡Ya casi terminás!',
  '¡Muy interesante!',
  '¡Excelente elección!',
  '¡Me encanta leer!',
];
---

<div class:list={['reading-cat', className]} id="readingCat">
  <div class="cat-bubble" id="catBubble">
    <span class="bubble-text" id="bubbleText"></span>
  </div>
  <div class="cat-body" role="button" tabindex="0" aria-label="Gato lector: tocá para que te diga algo">
    <svg
      viewBox="0 0 64 64"
      width="64"
      height="64"
      class="cat-svg"
      id="catSvg"
      aria-hidden="true"
    >
      <!-- Cola (detrás de la cabeza) -->
      <g class="cat-tail" id="catTail">
        <path d="M48 53 C59 56 64 47 60.5 41 C58.5 37.5 61 34.5 63.5 36.5" stroke="currentColor" stroke-width="5" fill="none" stroke-linecap="round" class="tail-path" />
      </g>

      <!-- Cabeza: una sola silueta con curvas, orejas redondeadas -->
      <path
        class="cat-face"
        fill="currentColor"
        d="M12 30 C10 22 10.5 14 12.5 8.5 C13.4 6.2 15.6 5.8 17.2 7.6 L24.5 15 C29.3 13.6 34.7 13.6 39.5 15 L46.8 7.6 C48.4 5.8 50.6 6.2 51.5 8.5 C53.5 14 54 22 52 30 C54 33.5 55 37.5 55 41 C55 51.5 45 58 32 58 C19 58 9 51.5 9 41 C9 37.5 10 33.5 12 30 Z"
      />
      <path class="cat-ear-inner" d="M15 11.5 C15.4 10.3 16.3 10.2 17 11 L21.5 15.8 C19 17 17 18.8 15.6 21 C14.6 17.8 14.5 14.4 15 11.5 Z" />
      <path class="cat-ear-inner" d="M49 11.5 C48.6 10.3 47.7 10.2 47 11 L42.5 15.8 C45 17 47 18.8 48.4 21 C49.4 17.8 49.5 14.4 49 11.5 Z" />

      <!-- Cachetes -->
      <ellipse cx="17.5" cy="44" rx="4" ry="2.6" class="cat-blush" />
      <ellipse cx="46.5" cy="44" rx="4" ry="2.6" class="cat-blush" />

      <!-- Ojos abiertos (parpadean) -->
      <g class="cat-eyes" id="catEyes">
        <g class="cat-eye">
          <ellipse cx="23.5" cy="36" rx="3.4" ry="4.2" fill="#0a0a0f" />
          <circle cx="24.7" cy="34.4" r="1.25" fill="#fff" />
          <circle cx="22.6" cy="37.6" r="0.6" fill="#fff" opacity="0.7" />
        </g>
        <g class="cat-eye">
          <ellipse cx="40.5" cy="36" rx="3.4" ry="4.2" fill="#0a0a0f" />
          <circle cx="41.7" cy="34.4" r="1.25" fill="#fff" />
          <circle cx="39.6" cy="37.6" r="0.6" fill="#fff" opacity="0.7" />
        </g>
      </g>

      <!-- Ojos cerrados (dormido) -->
      <g class="cat-eyes-closed" id="catEyesClosed">
        <path d="M19.8 36.2 Q23.5 39.4 27.2 36.2" stroke="#0a0a0f" stroke-width="1.6" fill="none" stroke-linecap="round" />
        <path d="M36.8 36.2 Q40.5 39.4 44.2 36.2" stroke="#0a0a0f" stroke-width="1.6" fill="none" stroke-linecap="round" />
      </g>

      <!-- Nariz y boca "ω" -->
      <path d="M30.2 42.2 C30.2 41.3 33.8 41.3 33.8 42.2 C33.8 43.1 32.6 44.1 32 44.1 C31.4 44.1 30.2 43.1 30.2 42.2 Z" class="cat-nose" />
      <path d="M28.6 45.6 C29.4 47.6 31.6 47.6 32 45.2 C32.4 47.6 34.6 47.6 35.4 45.6" stroke="#0a0a0f" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />

      <!-- Bigotes curvos -->
      <g class="cat-whiskers" stroke="#0a0a0f" stroke-width="0.9" stroke-linecap="round" fill="none">
        <path d="M10.5 40.8 Q14.8 40.6 18.8 42.2" />
        <path d="M10 45.2 Q14.4 44.6 18.6 45.1" />
        <path d="M53.5 40.8 Q49.2 40.6 45.2 42.2" />
        <path d="M54 45.2 Q49.6 44.6 45.4 45.1" />
      </g>

      <!-- Corazones (al terminar) -->
      <g class="cat-hearts" id="catHearts" transform="translate(-2 -2) scale(1.08)">
        <path class="heart heart-1" d="M10 14 C10 11.5 13.5 11 14 13.5 C14.5 11 18 11.5 18 14 C18 16.8 14 19 14 19 C14 19 10 16.8 10 14 Z" />
        <path class="heart heart-2" d="M47 8 C47 6.2 49.6 5.8 50 7.7 C50.4 5.8 53 6.2 53 8 C53 10 50 11.8 50 11.8 C50 11.8 47 10 47 8 Z" />
        <path class="heart heart-3" d="M29.5 4 C29.5 2.7 31.4 2.4 31.7 3.8 C32 2.4 33.9 2.7 33.9 4 C33.9 5.5 31.7 6.8 31.7 6.8 C31.7 6.8 29.5 5.5 29.5 4 Z" />
      </g>
    </svg>
  </div>
  <div class="cat-zzz" id="catZzz">
    <span class="zzz zzz-1">z</span>
    <span class="zzz zzz-2">z</span>
    <span class="zzz zzz-3">z</span>
  </div>
</div>

<style>
  .reading-cat {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .cat-bubble {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 0.5rem 0.75rem;
    position: relative;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity var(--dur-ui) var(--ease-out), transform var(--dur-ui) var(--ease-out);
    pointer-events: none;
  }

  .cat-bubble::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 6px solid var(--color-surface);
  }

  .cat-bubble.show {
    opacity: 1;
    transform: translateY(0);
  }

  .bubble-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text);
    white-space: nowrap;
  }

  .cat-body {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    padding: 0.55rem;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    transition: border-color var(--dur-ui) ease, transform var(--dur-press) var(--ease-out);
  }

  .cat-body:active {
    transform: scale(0.95);
  }

  @media (hover: hover) and (pointer: fine) {
    .cat-body:hover {
      border-color: var(--accent-line);
    }
  }

  .cat-svg {
    display: block;
    color: var(--color-text);
    overflow: visible;
  }

  .cat-ear-inner {
    fill: color-mix(in srgb, var(--color-accent) 35%, var(--color-text));
    opacity: 0.55;
  }

  .cat-blush {
    fill: var(--color-accent);
    opacity: 0.18;
  }

  .cat-nose {
    fill: var(--color-accent-hover);
  }

  .heart {
    fill: var(--color-accent);
  }

  /* Parpadeo: cada ~5s, rápido */
  .cat-eye {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 5s infinite;
  }

  .cat-eye:nth-child(2) {
    animation-delay: 0.04s;
  }

  @keyframes blink {
    0%, 94%, 100% {
      transform: scaleY(1);
    }
    96% {
      transform: scaleY(0.1);
    }
  }

  .cat-eyes-closed {
    display: none;
  }

  .cat-hearts {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .heart {
    transform-box: fill-box;
    transform-origin: center;
    animation: float-heart 2s ease-in-out infinite;
  }

  .heart-1 {
    animation-delay: 0s;
  }

  .heart-2 {
    animation-delay: 0.3s;
  }

  .heart-3 {
    animation-delay: 0.6s;
  }

  @keyframes float-heart {
    0%, 100% {
      transform: translateY(0) scale(1);
      opacity: 0.8;
    }
    50% {
      transform: translateY(-8px) scale(1.1);
      opacity: 1;
    }
  }

  .tail-path {
    animation: wag-tail 1.6s ease-in-out infinite;
    transform-origin: 48px 53px;
  }

  @keyframes wag-tail {
    0%, 100% {
      transform: rotate(-6deg);
    }
    50% {
      transform: rotate(6deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tail-path,
    .cat-eye,
    .heart,
    .zzz {
      animation: none;
    }
  }

  .cat-zzz {
    position: absolute;
    top: -20px;
    right: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .zzz {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
    animation: float-zzz 1.5s ease-in-out infinite;
  }

  .zzz-1 {
    font-size: 0.6rem;
    animation-delay: 0s;
  }

  .zzz-2 {
    font-size: 0.75rem;
    animation-delay: 0.3s;
  }

  .zzz-3 {
    font-size: 0.9rem;
    animation-delay: 0.6s;
  }

  @keyframes float-zzz {
    0%, 100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    50% {
      transform: translateY(-5px);
      opacity: 1;
    }
  }

  .reading-cat.sleeping .cat-eyes {
    display: none;
  }

  .reading-cat.sleeping .cat-eyes-closed {
    display: block;
  }

  .reading-cat.sleeping .cat-zzz {
    display: flex;
  }

  .reading-cat.sleeping .tail-path {
    animation: none;
  }

  .reading-cat.happy .cat-hearts {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .reading-cat {
      bottom: 1rem;
      right: 1rem;
      transform: scale(0.85);
      transform-origin: bottom right;
    }
  }
</style>

<script define:vars={{ messages }}>
  const readingCat = document.getElementById('readingCat');
  const catBubble = document.getElementById('catBubble');
  const bubbleText = document.getElementById('bubbleText');

  let scrollTimeout = null;
  let progress = 0;
  let messageIndex = 0;

  function showMessage(text) {
    if (bubbleText && catBubble) {
      bubbleText.textContent = text;
      catBubble.classList.add('show');

      setTimeout(() => {
        catBubble.classList.remove('show');
      }, 3000);
    }
  }

  function updateCatState() {
    if (!readingCat) return;

    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    progress = (scrollTop / docHeight) * 100;

    if (progress >= 99) {
      readingCat.classList.remove('sleeping');
      readingCat.classList.add('happy');
      showMessage('¡Terminaste! 💚');
    } else if (progress >= 75) {
      readingCat.classList.remove('sleeping', 'happy');
      showMessage('¡Ya casi terminás!');
    } else if (progress >= 50) {
      readingCat.classList.remove('sleeping', 'happy');
      showMessage('¡Vas por la mitad!');
    } else {
      readingCat.classList.remove('sleeping', 'happy');
    }
  }

  function checkIdle() {
    if (!readingCat) return;

    readingCat.classList.add('sleeping');
    readingCat.classList.remove('happy');
  }

  window.addEventListener('scroll', () => {
    updateCatState();

    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(checkIdle, 5000);
  });

  readingCat?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      readingCat.click();
    }
  });

  readingCat?.addEventListener('click', () => {
    messageIndex = (messageIndex + 1) % messages.length;
    showMessage(messages[messageIndex]);
  });

  setTimeout(() => {
    showMessage(messages[0]);
  }, 3000);
</script>
