---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const messages = [
  '¡Seguí leyendo!',
  '¡Qué bueno este post!',
  '¡Ya casi terminás!',
  '¡Muy interesante!',
  '¡Excelente elección!',
  '¡Me encanta leer!',
];
---

<div class:list={['reading-cat', className]} id="readingCat">
  <div class="cat-bubble" id="catBubble">
    <span class="bubble-text" id="bubbleText"></span>
  </div>
  <div class="cat-body">
    <svg
      viewBox="0 0 64 64"
      width="64"
      height="64"
      class="cat-svg"
      id="catSvg"
    >
      <g class="cat-ears">
        <polygon points="12,24 8,4 24,16" fill="currentColor" class="cat-ear cat-ear-left" />
        <polygon points="52,24 56,4 40,16" fill="currentColor" class="cat-ear cat-ear-right" />
      </g>
      <ellipse cx="32" cy="38" rx="24" ry="20" fill="currentColor" class="cat-face" />
      <g class="cat-eyes" id="catEyes">
        <ellipse cx="22" cy="34" rx="4" ry="5" fill="#0a0a0f" class="cat-eye cat-eye-left" />
        <ellipse cx="42" cy="34" rx="4" ry="5" fill="#0a0a0f" class="cat-eye cat-eye-right" />
        <ellipse cx="23" cy="33" rx="1.5" ry="2" fill="#fff" class="cat-pupil cat-pupil-left" />
        <ellipse cx="43" cy="33" rx="1.5" ry="2" fill="#fff" class="cat-pupil cat-pupil-right" />
      </g>
      <g class="cat-eyes-closed" id="catEyesClosed">
        <path d="M18,34 Q22,38 26,34" stroke="#0a0a0f" stroke-width="2" fill="none" class="cat-eye-closed cat-eye-closed-left" />
        <path d="M38,34 Q42,38 46,34" stroke="#0a0a0f" stroke-width="2" fill="none" class="cat-eye-closed cat-eye-closed-right" />
      </g>
      <ellipse cx="32" cy="42" rx="3" ry="2" fill="#ffb6c1" class="cat-nose" />
      <g class="cat-whiskers">
        <line x1="10" y1="40" x2="22" y2="42" stroke="#0a0a0f" stroke-width="1" class="whisker" />
        <line x1="10" y1="44" x2="22" y2="44" stroke="#0a0a0f" stroke-width="1" class="whisker" />
        <line x1="10" y1="48" x2="22" y2="46" stroke="#0a0a0f" stroke-width="1" class="whisker" />
        <line x1="54" y1="40" x2="42" y2="42" stroke="#0a0a0f" stroke-width="1" class="whisker" />
        <line x1="54" y1="44" x2="42" y2="44" stroke="#0a0a0f" stroke-width="1" class="whisker" />
        <line x1="54" y1="48" x2="42" y2="46" stroke="#0a0a0f" stroke-width="1" class="whisker" />
      </g>
      <g class="cat-tail" id="catTail">
        <path d="M56,50 Q70,40 65,60" stroke="currentColor" stroke-width="4" fill="none" stroke-linecap="round" class="tail-path" />
      </g>
      <g class="cat-hearts" id="catHearts">
        <text x="10" y="20" font-size="12" class="heart heart-1">💚</text>
        <text x="48" y="18" font-size="10" class="heart heart-2">💚</text>
        <text x="28" y="12" font-size="8" class="heart heart-3">💚</text>
      </g>
    </svg>
  </div>
  <div class="cat-zzz" id="catZzz">
    <span class="zzz zzz-1">z</span>
    <span class="zzz zzz-2">z</span>
    <span class="zzz zzz-3">z</span>
  </div>
</div>

<style>
  .reading-cat {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 90;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .cat-bubble {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 0.5rem 0.75rem;
    position: relative;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    max-width: 150px;
  }

  .cat-bubble::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 6px solid var(--color-surface);
  }

  .cat-bubble.show {
    opacity: 1;
    transform: translateY(0);
  }

  .bubble-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text);
    white-space: nowrap;
  }

  .cat-body {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    padding: 0.5rem;
    transition: border-color 0.3s ease;
  }

  .cat-body:hover {
    border-color: var(--color-accent);
  }

  .cat-svg {
    color: var(--color-text);
    overflow: visible;
  }

  .cat-eyes-closed {
    display: none;
  }

  .cat-hearts {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .heart {
    animation: float-heart 2s ease-in-out infinite;
  }

  .heart-1 {
    animation-delay: 0s;
  }

  .heart-2 {
    animation-delay: 0.3s;
  }

  .heart-3 {
    animation-delay: 0.6s;
  }

  @keyframes float-heart {
    0%, 100% {
      transform: translateY(0) scale(1);
      opacity: 0.8;
    }
    50% {
      transform: translateY(-8px) scale(1.1);
      opacity: 1;
    }
  }

  .tail-path {
    animation: wag-tail 1s ease-in-out infinite;
    transform-origin: 56px 50px;
  }

  @keyframes wag-tail {
    0%, 100% {
      transform: rotate(-5deg);
    }
    50% {
      transform: rotate(5deg);
    }
  }

  .cat-zzz {
    position: absolute;
    top: -20px;
    right: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .zzz {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
    animation: float-zzz 1.5s ease-in-out infinite;
  }

  .zzz-1 {
    font-size: 0.6rem;
    animation-delay: 0s;
  }

  .zzz-2 {
    font-size: 0.75rem;
    animation-delay: 0.3s;
  }

  .zzz-3 {
    font-size: 0.9rem;
    animation-delay: 0.6s;
  }

  @keyframes float-zzz {
    0%, 100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    50% {
      transform: translateY(-5px);
      opacity: 1;
    }
  }

  .reading-cat.sleeping .cat-eyes {
    display: none;
  }

  .reading-cat.sleeping .cat-eyes-closed {
    display: block;
  }

  .reading-cat.sleeping .cat-zzz {
    display: flex;
  }

  .reading-cat.sleeping .tail-path {
    animation: none;
  }

  .reading-cat.happy .cat-hearts {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .reading-cat {
      bottom: 1rem;
      right: 1rem;
      transform: scale(0.85);
      transform-origin: bottom right;
    }
  }
</style>

<script define:vars={{ messages }}>
  const readingCat = document.getElementById('readingCat');
  const catBubble = document.getElementById('catBubble');
  const bubbleText = document.getElementById('bubbleText');

  let scrollTimeout = null;
  let progress = 0;
  let messageIndex = 0;

  function showMessage(text) {
    if (bubbleText && catBubble) {
      bubbleText.textContent = text;
      catBubble.classList.add('show');

      setTimeout(() => {
        catBubble.classList.remove('show');
      }, 3000);
    }
  }

  function updateCatState() {
    if (!readingCat) return;

    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    progress = (scrollTop / docHeight) * 100;

    if (progress >= 99) {
      readingCat.classList.remove('sleeping');
      readingCat.classList.add('happy');
      showMessage('¡Terminaste! 💚');
    } else if (progress >= 75) {
      readingCat.classList.remove('sleeping', 'happy');
      showMessage('¡Ya casi terminás!');
    } else if (progress >= 50) {
      readingCat.classList.remove('sleeping', 'happy');
      showMessage('¡Vas por la mitad!');
    } else {
      readingCat.classList.remove('sleeping', 'happy');
    }
  }

  function checkIdle() {
    if (!readingCat) return;

    readingCat.classList.add('sleeping');
    readingCat.classList.remove('happy');
  }

  window.addEventListener('scroll', () => {
    updateCatState();

    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(checkIdle, 5000);
  });

  readingCat?.addEventListener('click', () => {
    messageIndex = (messageIndex + 1) % messages.length;
    showMessage(messages[messageIndex]);
  });

  setTimeout(() => {
    showMessage(messages[0]);
  }, 3000);
</script>
