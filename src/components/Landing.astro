---
import Layout from '../layouts/Layout.astro';
import Motion from './Motion.astro';
import Hero from './Hero.astro';
import Marquee from './Marquee.astro';
import Now from './Now.astro';
import Projects from './Projects.astro';
import BuilderLog from './BuilderLog.astro';
import Experience from './Experience.astro';
import About from './About.astro';
import Stack from './Stack.astro';
import LatestPosts from './LatestPosts.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import EasterEggs from './EasterEggs.astro';
import { type Lang, useTranslations } from '../i18n/ui';
import { getBuilds } from '../lib/builds';
import { landingSchema } from '../lib/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const jsonLd = landingSchema(lang, await getBuilds());
---

<Layout
  title={t('meta.title')}
  description={t('meta.description')}
  lang={lang}
  alternates={{ es: '/', en: '/en/' }}
  type="profile"
  imageAlt={lang === 'en' ? 'Nico Tomasin — Builder & Product Manager at G2M' : 'Nico Tomasin — Builder y Product Manager en G2M'}
  jsonLd={jsonLd}
>
  <Motion />
  <main class="landing">
    <Hero lang={lang} />
    <Marquee items={[...t('marquee.top')]} />
    <Now lang={lang} />
    <Projects lang={lang} />
    <BuilderLog lang={lang} />
    <Experience lang={lang} />
    <About lang={lang} />
    <Stack lang={lang} />
    <LatestPosts lang={lang} />
    <Marquee items={[...t('marquee.bottom')]} reverse outline />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
  <EasterEggs />
</Layout>
