---
import portfolioData from '../data/portfolio.json';
import RubikCube from './RubikCube.astro';
import { type Lang, l, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { about } = portfolioData;
---

<section id="sobre-mi" class="section about">
  <div class="container about-grid">
    <div class="about-text">
      <header class="section-header">
        <p class="section-label" data-reveal>{t('about.label')}</p>
        <h2 class="section-title" data-split>{t('about.title')}</h2>
      </header>

      <div class="about-copy">
        {l(about.paragraphs, lang).map((paragraph) => (
          <p data-reveal>{paragraph}</p>
        ))}
      </div>

      <ul class="about-facts">
        {about.facts.map((fact) => (
          <li class="about-fact" data-batch>{l(fact, lang)}</li>
        ))}
      </ul>
    </div>

    <div class="about-visual" data-reveal>
      <RubikCube label={t('about.cube')} solveLabel={t('about.cubeSolve')} />
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-bg);
    overflow: hidden;
  }

  .about-grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
    }
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 62ch;
  }

  .about-copy p {
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .about-copy p:first-child {
    color: var(--color-text);
  }

  .about-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .about-fact {
    padding: 0.45rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    background: var(--color-surface);
  }

  .about-visual {
    display: grid;
    place-items: center;
  }
</style>
