---
import { getCollection } from 'astro:content';
import { calculateReadingTime, formatReadingTime } from '../lib/reading-time';
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
const locale = lang === 'en' ? 'en-US' : 'es-AR';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((entry) => ({
    slug: entry.id,
    // Portada: primera imagen del post; si no tiene, una portada generativa
    cover: (entry.body || '').match(/!\[[^\]]*\]\((\/blog\/[^)\s]+)\)/)?.[1] ?? null,
    hue: [...entry.id].reduce((acc, ch) => (acc * 31 + ch.charCodeAt(0)) % 360, 7),
    topic: entry.data.tags?.[0] ?? entry.data.category,
    title: entry.data.title,
    description: entry.data.description,
    category: entry.data.category,
    date: entry.data.date.toLocaleDateString(locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }),
    readingTime: formatReadingTime(calculateReadingTime(entry.body || '')),
  }));
---

{posts.length > 0 && (
  <section id="blog" class="section latest" data-latest>
    <div class="container">
      <header class="latest-header">
        <div>
          <p class="section-label" data-reveal>{t('blog.label')}</p>
          <h2 class="section-title" data-split>{t('blog.title')}</h2>
          {t('blog.lang') && <p class="latest-lang" data-reveal>{t('blog.lang')}</p>}
        </div>
        <a href="/blog" class="latest-all" data-reveal data-magnetic data-cursor={t('blog.all')}>
          <span>{t('blog.all')}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </header>

      <div class="latest-grid">
        {posts.map((post, i) => (
          <a href={`/blog/${post.slug}`} class:list={['post', { 'post-featured': i === 0 }]} data-post data-cursor={t('featured.read')} lang="es">
            <div class="post-media" data-post-media>
              {post.cover ? (
                <img src={post.cover} alt="" loading="lazy" data-post-img />
              ) : (
                <div class="post-cover" data-post-img style={`--x1:${10 + (post.hue % 40)}%;--y1:${15 + (post.hue % 30)}%;--x2:${60 + (post.hue % 30)}%;--y2:${55 + (post.hue % 35)}%`}>
                  <span class="post-cover-topic">#{post.topic}</span>
                </div>
              )}
              <span class="post-index">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="post-body">
              <div class="post-meta" data-post-fade>
                <span class="post-category">{post.category}</span>
                <span aria-hidden="true">·</span>
                <span>{post.date}</span>
                <span aria-hidden="true">·</span>
                <span>{post.readingTime}</span>
              </div>
              <h3 class="post-title" data-post-fade>
                <span class="post-title-text">{post.title}</span>
              </h3>
              {i === 0 && <p class="post-desc" data-post-fade>{post.description}</p>}
              <span class="post-arrow" data-post-fade aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .latest-lang {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .latest {
    background: var(--color-bg);
  }

  .latest-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .latest-header .section-title {
    margin: 0;
  }

  .latest-all {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--color-text);
    transition: border-color 0.3s ease, color 0.3s ease;
  }

  .latest-all svg {
    transition: transform 0.3s ease;
  }

  .latest-all:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .latest-all:hover svg {
    transform: translateX(4px);
  }

  .latest-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .latest-grid {
      grid-template-columns: 1.35fr 1fr;
      grid-template-rows: auto auto;
      gap: 2.5rem 3rem;
    }

    .post-featured {
      grid-row: span 2;
    }
  }

  .post {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  .post:hover {
    color: inherit;
  }

  .post-media {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    aspect-ratio: 1200 / 630;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .post-media img,
  .post-cover {
    position: absolute;
    left: 0;
    top: -6%;
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: center top;
    will-change: transform;
    transition: filter 0.6s ease;
  }

  /* Portada generativa para posts sin capturas */
  .post-cover {
    display: grid;
    place-items: center;
    background:
      /* Solo colores de la paleta; lo que varía por post es la posición */
      radial-gradient(circle at var(--x1) var(--y1), color-mix(in srgb, var(--color-accent) 38%, transparent), transparent 55%),
      radial-gradient(circle at var(--x2) var(--y2), color-mix(in srgb, var(--color-accent-hover) 22%, transparent), transparent 50%),
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px) 0 0 / 28px 28px,
      #0b0b12;
  }

  .post-cover-topic {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: rgba(255, 255, 255, 0.92);
    letter-spacing: -0.02em;
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
  }

  .post-index {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    color: var(--color-text);
    background: rgba(10, 10, 15, 0.7);
    backdrop-filter: blur(6px);
    padding: 0.3rem 0.6rem;
    border-radius: 100px;
  }

  .post-body {
    position: relative;
    padding-right: 3rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .post-category {
    color: var(--color-accent);
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0;
  }

  .post-featured .post-title {
    font-size: clamp(1.5rem, 2.8vw, 2.4rem);
  }

  /* Subrayado que crece en hover */
  .post-title-text {
    background-image: linear-gradient(var(--color-accent), var(--color-accent));
    background-size: 0% 2px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 0.6s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .post-desc {
    margin: 0.85rem 0 0;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 52ch;
  }

  .post-arrow {
    position: absolute;
    top: 0;
    right: 0;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  @media (hover: hover) {
    .post:hover .post-title-text {
      background-size: 100% 2px;
    }

    .post:hover .post-arrow {
      transform: rotate(45deg);
      background: var(--color-accent);
      border-color: var(--color-accent);
      color: var(--color-bg);
    }

    .post:hover .post-media img {
      filter: saturate(1.2) brightness(1.08);
    }
  }
</style>
