---
import ShaderBackground from './ShaderBackground.astro';
import portfolioData from '../data/portfolio.json';
import { type Lang, l, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { hero } = portfolioData;
const nameLines = ['Nico', 'Tomasin'];
---

<section id="inicio" class="hero" data-hero>
  <div class="hero-bg" data-hero-bg>
    <ShaderBackground />
    <div class="hero-overlay"></div>
  </div>
  <div class="hero-fade-bottom"></div>

  <div class="hero-content container" data-hero-content>
    <div class="hero-top" data-hero-fade>
      <p class="hero-kicker">{l(hero.kicker, lang)}</p>
      <span class="hero-status">
        <span class="kicker-dot" aria-hidden="true"></span>
        {l(hero.status, lang)}
      </span>
    </div>

    <h1 class="hero-name">
      <span class="sr-only">Nico Tomasin — {l(hero.role, lang)}</span>
      {nameLines.map((line, li) => (
        <span class={`hero-line hero-line-${li}`} aria-hidden="true" data-hero-line>
          {line.split('').map((ch) => (
            <span class="char-mask"><span class="char" data-hero-char>{ch}</span></span>
          ))}
        </span>
      ))}
    </h1>

    <div class="hero-bottom">
      <p class="hero-description" data-hero-fade>{l(hero.description, lang)}</p>

      <div class="hero-meta" data-hero-fade>
        <span class="hero-title">{l(hero.role, lang)}</span>
        <div class="hero-actions">
          <a href="#builder-log" class="btn-primary pressable" data-magnetic>
            <span class="btn-label">{t('hero.cta')}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
          </a>
          <a href="/blog" class="btn-ghost pressable">{t('hero.blog')}</a>
        </div>
      </div>
    </div>
  </div>

  <a href="#ahora" class="scroll-indicator" data-hero-fade aria-label={t('hero.scroll')}>
    <span class="scroll-text">{t('hero.scroll')}</span>
    <span class="scroll-line"><span class="scroll-line-fill"></span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #000;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    transform-origin: 50% 40%;
    will-change: transform, opacity;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 0%, rgba(10, 10, 15, 0.35) 65%, rgba(10, 10, 15, 0.85) 100%);
    z-index: 1;
  }

  .hero-fade-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 35%;
    background: linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.75) 35%, transparent 100%);
    z-index: 1;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: calc(var(--nav-height) + 3rem);
    padding-bottom: 7rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    will-change: transform;
  }

  .hero-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.8rem 0.35rem 0.65rem;
    border: 1px solid var(--accent-line);
    border-radius: 100px;
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    backdrop-filter: blur(6px);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .hero-name {
    font-family: var(--font-serif);
    display: flex;
    flex-direction: column;
    /* Tope por ancho y por alto: no desborda en 320px ni en landscape bajo */
    font-size: clamp(3.5rem, min(20vw, 30svh), 15rem);
    font-weight: 400;
    /* Un solo estilo para las dos líneas: Instrument Serif itálica */
    font-style: italic;
    letter-spacing: -0.03em;
    line-height: 0.85;
    margin: 0;
  }

  .hero-line {
    display: block;
    white-space: nowrap;
  }

  .hero-line-1 {
    padding-left: clamp(0.75rem, 12vw, 14rem);
    color: var(--color-accent);
  }

  .char-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.04em;
  }

  /* La máscara solo tiene que recortar abajo (las letras suben desde ahí).
     Con overflow: hidden también cortaba los costados y la itálica (la "T") quedaba con un corte vertical */
  .hero-name .char-mask {
    overflow: visible;
    clip-path: inset(-0.5em -0.5em 0 -0.5em);
    padding-bottom: 0.08em;
  }

  .char {
    display: inline-block;
    will-change: transform;
  }

  .hero-bottom {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: 1rem;
  }

  @media (min-width: 900px) {
    .hero-bottom {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .hero-description {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--color-text-secondary);
    max-width: 46ch;
    text-wrap: pretty;
    line-height: 1.6;
    margin: 0;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.15em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 1rem 1.25rem;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--color-text);
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    transition: border-color var(--dur-ui) ease, color var(--dur-ui) ease, transform var(--dur-press) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-ghost:hover {
      border-color: var(--accent-line);
      color: var(--color-text);
    }
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.75rem;
    background: var(--color-accent);
    color: var(--color-bg);
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 100px;
    text-decoration: none;
    transition: background-color var(--dur-ui) ease, box-shadow var(--dur-ui) ease, transform var(--dur-press) var(--ease-out);
  }

  .btn-primary svg {
    transition: transform var(--dur-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover {
      background: var(--color-accent-hover);
      color: var(--color-bg);
      box-shadow: 0 10px 40px rgba(0, 255, 136, 0.25);
    }

    .btn-primary:hover svg {
      transform: translateY(2px);
    }
  }

  .scroll-indicator {
    display: none;
    position: absolute;
    right: 1.5rem;
    bottom: 2rem;
    z-index: 2;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text-secondary);
  }

  .scroll-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .scroll-line {
    position: relative;
    width: 1px;
    height: 56px;
    background: rgba(255, 255, 255, 0.15);
    overflow: hidden;
  }

  .scroll-line-fill {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    animation: scroll-line 2s cubic-bezier(0.77, 0, 0.175, 1) infinite;
  }

  @media (min-width: 900px) {
    .scroll-indicator {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kicker-dot,
    .scroll-line-fill {
      animation: none;
    }
  }

  @keyframes scroll-line {
    0% { transform: translateY(-100%); }
    50% { transform: translateY(0); }
    100% { transform: translateY(100%); }
  }
</style>
