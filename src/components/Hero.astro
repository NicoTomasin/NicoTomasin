---
import ShaderBackground from './ShaderBackground.astro';
import portfolioData from '../data/portfolio.json';

const { hero } = portfolioData;
const nameLines = ['Nico', 'Tomasin'];
---

<section id="inicio" class="hero" data-hero>
  <div class="hero-bg" data-hero-bg>
    <ShaderBackground />
    <div class="hero-overlay"></div>
  </div>
  <div class="hero-fade-bottom"></div>

  <div class="hero-content container" data-hero-content>
    <p class="hero-kicker" data-hero-fade>
      <span class="kicker-dot"></span>
      Performance · UX · Resultados reales
    </p>

    <h1 class="hero-name" aria-label="Nico Tomasin">
      {nameLines.map((line, li) => (
        <span class={`hero-line hero-line-${li}`} aria-hidden="true" data-hero-line>
          {line.split('').map((ch) => (
            <span class="char-mask"><span class="char" data-hero-char>{ch}</span></span>
          ))}
        </span>
      ))}
    </h1>

    <div class="hero-bottom">
      <p class="hero-description" data-hero-fade>{hero.description}</p>

      <div class="hero-meta" data-hero-fade>
        <span class="hero-title">{hero.title}</span>
        <a href="/blog" class="btn-primary" data-magnetic data-cursor="Leer">
          <span class="btn-label">Ir al Blog</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>

  <a href="#proyectos" class="scroll-indicator" data-hero-fade aria-label="Bajar a proyectos">
    <span class="scroll-text">Scroll</span>
    <span class="scroll-line"><span class="scroll-line-fill"></span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #000;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    transform-origin: 50% 40%;
    will-change: transform, opacity;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 0%, rgba(10, 10, 15, 0.35) 65%, rgba(10, 10, 15, 0.85) 100%);
    z-index: 1;
  }

  .hero-fade-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 35%;
    background: linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.75) 35%, transparent 100%);
    z-index: 1;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: calc(var(--nav-height) + 3rem);
    padding-bottom: 7rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    will-change: transform;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .hero-name {
    font-family: var(--font-display);
    display: flex;
    flex-direction: column;
    font-size: clamp(3.75rem, 13.5vw, 12.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.86;
    text-transform: uppercase;
    margin: 0;
  }

  .hero-line {
    display: block;
    white-space: nowrap;
  }

  .hero-line-1 {
    padding-left: clamp(2rem, 14vw, 14rem);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    letter-spacing: -0.02em;
    font-size: 1.12em;
    line-height: 0.9;
    color: var(--color-accent);
  }

  .char-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.04em;
  }

  /* Margen extra para que la itálica no se corte dentro de la máscara */
  .hero-line-1 .char-mask {
    padding: 0 0.06em 0.08em;
    margin: 0 -0.06em;
  }

  .char {
    display: inline-block;
    will-change: transform;
  }

  .hero-bottom {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: 1rem;
  }

  @media (min-width: 900px) {
    .hero-bottom {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .hero-description {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--color-text-secondary);
    max-width: 440px;
    line-height: 1.6;
    margin: 0;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.15em;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.75rem;
    background: var(--color-accent);
    color: var(--color-bg);
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 100px;
    text-decoration: none;
    transition: background-color 0.2s ease, box-shadow 0.3s ease;
  }

  .btn-primary:hover {
    background: var(--color-accent-hover);
    color: var(--color-bg);
    box-shadow: 0 10px 40px rgba(0, 255, 136, 0.3);
  }

  .btn-primary svg {
    transition: transform 0.3s ease;
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .scroll-indicator {
    position: absolute;
    right: 1.5rem;
    bottom: 2rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text-secondary);
  }

  .scroll-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .scroll-line {
    position: relative;
    width: 1px;
    height: 56px;
    background: rgba(255, 255, 255, 0.15);
    overflow: hidden;
  }

  .scroll-line-fill {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    animation: scroll-line 2s cubic-bezier(0.77, 0, 0.175, 1) infinite;
  }

  @keyframes scroll-line {
    0% { transform: translateY(-100%); }
    50% { transform: translateY(0); }
    100% { transform: translateY(100%); }
  }
</style>
