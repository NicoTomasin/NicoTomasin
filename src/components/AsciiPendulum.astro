            0 0 20px rgba(171, 209, 198, 0.3),
            0 0 30px rgba(171, 209, 198, 0.1);
        white-space: pre;
        animation: pulse 3s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% { 
            opacity: 1;
            filter: brightness(1);
        }
        50% { 
            opacity: 0.85;
            filter: brightness(1.1);
        }
    }
</style>
