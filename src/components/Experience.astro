---
import portfolioData from '../data/portfolio.json';

const { experience } = portfolioData;
---

<section id="experiencia" class="section experience">
  <div class="container">
    <header class="section-header">
      <p class="section-label" data-reveal>Trayectoria</p>
      <h2 class="section-title" data-split>Mi camino profesional</h2>
    </header>

    <ol class="jobs">
      {experience.map((job, index) => (
        <li class="job" data-job>
          <span class="job-line" data-job-line></span>
          <div class="job-inner">
            <span class="job-index" data-job-fade>{String(index + 1).padStart(2, '0')}</span>
            <div class="job-main">
              <h3 class="job-role" data-job-fade>{job.role}</h3>
              <span class="job-company" data-job-fade>@ {job.company}</span>
            </div>
            <p class="job-description" data-job-fade>{job.description}</p>
            <span class="job-period" data-job-fade>{job.period}</span>
          </div>
        </li>
      ))}
      <li class="job job-end" aria-hidden="true" data-job><span class="job-line" data-job-line></span></li>
    </ol>
  </div>
</section>

<style>
  .experience {
    background: var(--color-bg);
    position: relative;
  }

  .jobs {
    display: flex;
    flex-direction: column;
  }

  .job {
    position: relative;
  }

  .job-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-border);
    transform-origin: left;
  }

  .job-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.77, 0, 0.175, 1);
  }


  .job-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem 1.25rem;
    padding: 2rem 0;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }


  .job-index {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
    padding-top: 0.6rem;
  }

  .job-main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .job-role {
    font-size: clamp(1.6rem, 3.5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0;
    color: var(--color-text);
    transition: color 0.3s ease;
  }


  .job-company {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }

  .job-description {
    grid-column: 2;
    font-size: 0.98rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    max-width: 520px;
  }

  .job-period {
    grid-column: 2;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (min-width: 900px) {
    .job-inner {
      grid-template-columns: 4rem 1.2fr 1fr 11rem;
      align-items: start;
      gap: 2rem;
      padding: 2.75rem 0;
    }

    .job-description,
    .job-period {
      grid-column: auto;
    }

    .job-description {
      padding-top: 0.5rem;
    }

    .job-period {
      text-align: right;
      padding-top: 0.75rem;
    }
  }

  @media (hover: hover) {
    .job:hover .job-line::after {
      transform: scaleX(1);
    }

    .job:hover .job-inner {
      transform: translateX(10px);
    }

    .job:hover .job-role {
      color: var(--color-accent);
    }
  }

  .job-end {
    height: 1px;
  }
</style>
