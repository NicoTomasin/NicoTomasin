---
interface Props {
  intensity?: number;
  id?: string;
}

const { intensity = 1, id = 'shader-canvas' } = Astro.props;
---

<canvas id={id} class="blackhole" data-blackhole data-intensity={intensity} aria-hidden="true"></canvas>

<style>
  .blackhole {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    display: block;
  }

  /* Sin WebGL2: un halo con la paleta en lugar del agujero negro */
  .blackhole[data-fallback] {
    background:
      radial-gradient(circle at 50% 42%, #000 0 18%, transparent 19%),
      radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--color-accent) 35%, transparent) 0 24%, transparent 46%),
      radial-gradient(ellipse at 50% 42%, var(--color-surface) 0%, var(--color-bg) 70%);
  }
</style>

<script>
  import { mountBlackhole } from '../lib/blackhole-shader';

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-blackhole]').forEach((canvas) => {
    if (canvas.dataset.mounted) return;
    canvas.dataset.mounted = 'true';
    mountBlackhole(canvas, { intensity: Number(canvas.dataset.intensity) || 1 });
  });
</script>
