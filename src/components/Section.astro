---
interface Props {
  className?: string;
  noBorderBottom?: boolean;
}

const { className = "", noBorderBottom = false } = Astro.props;
---

<section class:list={["section", className, { "no-border": noBorderBottom }]}>
  <slot />
</section>

<style>
  .section {
    border-bottom: 1px solid var(--border-color);
    padding: 0;
    position: relative;
    background-color: var(--color-bg);
  }

  .section.no-border {
    border-bottom: none;
  }
</style>
