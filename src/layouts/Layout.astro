---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/share-tech-mono/400.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/800.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: Lang;
  /** Rutas equivalentes en otros idiomas (solo la landing las tiene) */
  alternates?: Partial<Record<Lang, string>>;
}

const siteUrl = "https://nicotomasin.com.ar";
const defaultTitle = "Nico Tomasin | Builder · Product Manager en G2M";
const defaultDescription = "Nico Tomasin: Product Manager en G2M y builder. Construyo lo que me da curiosidad: bots en Rust, hardware con ESP32, productos web y herramientas con IA.";
const defaultImage = "/og.png";

const { 
  title = defaultTitle, 
  description = defaultDescription,
  image = defaultImage,
  lang = 'es',
  alternates,
} = Astro.props;

const ogImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta name="author" content="Nico Tomasin" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    {alternates && Object.entries(alternates).map(([code, path]) => (
      <link rel="alternate" hreflang={code} href={new URL(path!, siteUrl).toString()} />
    ))}
    {alternates?.es && <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, siteUrl).toString()} />}
    <link rel="alternate" type="application/rss+xml" title="Nico Tomasin — Blog" href="/blog/rss.xml" />
    
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Nico Tomasin" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_AR'} />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:creator" content="@NicoTomasin_" />
    
    <script type="module">
      // Scripts externos pesados: solo se cargan si la página los usa
      if (document.querySelector('.twitter-tweet')) {
        const s = document.createElement('script');
        s.src = 'https://platform.twitter.com/widgets.js';
        s.async = true;
        document.head.appendChild(s);
      }

      if (document.querySelector('pre.mermaid')) {
        const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@12.2.0/dist/mermaid.esm.min.mjs');
        mermaid.initialize({
        startOnLoad: false,
        look: 'classic',
        theme: 'dark',
        themeVariables: {
          fontFamily: 'Inter, system-ui, sans-serif',
          primaryColor: '#12121a',
          primaryTextColor: '#e4e4e7',
          primaryBorderColor: '#00ff88',
          lineColor: '#a1a1aa',
          secondaryColor: '#1e1e2e',
          tertiaryColor: '#12121a',
          background: '#0a0a0f',
          mainBkg: '#12121a',
          nodeBorder: '#00cc6a',
          clusterBkg: '#0a0a0f',
          clusterBorder: '#1e1e2e',
          titleColor: '#e4e4e7',
          edgeLabelBackground: '#0a0a0f',
          actorBkg: '#12121a',
          actorBorder: '#00cc6a',
          noteBkgColor: '#1e1e2e',
          noteTextColor: '#e4e4e7',
        }
        });
        await mermaid.run({ querySelector: 'pre.mermaid' });
      }
    </script>
  </head>
  <body>
    <Navbar lang={lang} alternates={alternates} />
    <slot />
  </body>
</html>
